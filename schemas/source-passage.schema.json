{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source-passage.schema.json",
  "title": "Pro-One Source Passage",
  "description": "A minimal curated excerpt. Source URL, citation, authority, dates and rights resolve through source_id; verification is research, not legal approval.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schema_version",
    "record_version",
    "last_modified",
    "title",
    "status",
    "review",
    "source_id",
    "workflow_ids",
    "jurisdiction",
    "locator",
    "propositions",
    "text",
    "verification",
    "limitations",
    "legal_rule_ids",
    "process_step_ids"
  ],
  "properties": {
    "public_currentness": {
      "$ref": "common.schema.json#/$defs/publicCurrentness"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/recordId"
    },
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "record_version": {
      "$ref": "common.schema.json#/$defs/recordVersion"
    },
    "last_modified": {
      "$ref": "common.schema.json#/$defs/lastModified"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "$ref": "common.schema.json#/$defs/maturityStatus"
    },
    "review": {
      "$ref": "common.schema.json#/$defs/reviewInformation"
    },
    "source_id": {
      "$ref": "common.schema.json#/$defs/recordId"
    },
    "workflow_ids": {
      "$ref": "common.schema.json#/$defs/recordIdArray"
    },
    "jurisdiction": {
      "$ref": "common.schema.json#/$defs/jurisdiction"
    },
    "locator": {
      "type": "string",
      "minLength": 1
    },
    "propositions": {
      "description": "Stable topic tags local to the passage corpus, not foreign-key records or assertions of legal approval.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/recordId"
      }
    },
    "text": {
      "description": "Exact short excerpt with whitespace flattened where necessary; read with locator and limitations.",
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retrieved_on",
        "verified_on",
        "source_version",
        "excerpt_hash",
        "method"
      ],
      "properties": {
        "retrieved_on": {
          "type": "string",
          "format": "date"
        },
        "verified_on": {
          "type": "string",
          "format": "date"
        },
        "source_version": {
          "type": "string",
          "minLength": 1
        },
        "excerpt_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "method": {
          "enum": [
            "manual_official_source_check",
            "bounded_official_source_fetch",
            "compiler_exact_text_check",
            "provider_exact_text_check"
          ]
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "legal_rule_ids": {
      "$ref": "common.schema.json#/$defs/recordIdArray"
    },
    "process_step_ids": {
      "$ref": "common.schema.json#/$defs/recordIdArray"
    },
    "external_context": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "opinion", "cluster", "opinion_role", "classification", "source_hash", "start", "end", "context_window"],
      "properties": {
        "provider": {"const": "courtlistener"},
        "opinion": {"type": "integer", "minimum": 1},
        "cluster": {"type": "integer", "minimum": 1},
        "opinion_role": {"type": "string", "minLength": 1, "maxLength": 40},
        "classification": {"enum": ["candidate_reasoning", "candidate_dissent", "candidate_concurrence", "unknown"]},
        "source_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 1},
        "context_window": {"type": "string", "maxLength": 4000}
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "supported"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "review": {
            "properties": {
              "status": {
                "const": "approved"
              },
              "review_scope": {
                "allOf": [
                  {
                    "contains": {
                      "const": "schema"
                    }
                  },
                  {
                    "contains": {
                      "const": "source_authority"
                    }
                  },
                  {
                    "contains": {
                      "const": "source_freshness"
                    }
                  },
                  {
                    "contains": {
                      "const": "jurisdiction"
                    }
                  },
                  {
                    "contains": {
                      "const": "legal_information_boundary"
                    }
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
