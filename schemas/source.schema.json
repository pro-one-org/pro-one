{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source.schema.json",
  "title": "Pro-One Source Metadata",
  "description": "Metadata schema for legal and legal-information sources used by Pro-One.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schema_version",
    "record_version",
    "last_modified",
    "title",
    "status",
    "source_type",
    "url",
    "jurisdiction",
    "authority",
    "dates",
    "provenance",
    "access",
    "rights",
    "review",
    "workflow_fit",
    "citation"
  ],
  "properties": {
    "public_currentness": { "$ref": "common.schema.json#/$defs/publicCurrentness" },
    "id": {
      "$ref": "common.schema.json#/$defs/recordId"
    },
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "record_version": {
      "$ref": "common.schema.json#/$defs/recordVersion"
    },
    "last_modified": {
      "$ref": "common.schema.json#/$defs/lastModified"
    },
    "title": {
      "type": "string",
      "description": "Human-readable source title."
    },
    "status": {
      "$ref": "common.schema.json#/$defs/maturityStatus"
    },
    "description": {
      "type": "string",
      "description": "Short explanation of what the source contains."
    },
    "source_type": {
      "type": "string",
      "description": "General category of source.",
      "enum": [
        "statute",
        "regulation",
        "court_rule",
        "court_form",
        "court_instruction",
        "agency_rule",
        "agency_guidance",
        "official_self_help",
        "legal_aid_resource",
        "secondary_resource",
        "court_opinion",
        "other"
      ]
    },
    "url": {
      "type": "string",
      "format": "uri",
      "description": "Canonical public URL for the source."
    },
    "jurisdiction": {
      "$ref": "common.schema.json#/$defs/jurisdiction"
    },
    "authority": {
      "type": "object",
      "description": "Authority level and issuing body for the source.",
      "additionalProperties": false,
      "required": [
        "level",
        "issuing_body"
      ],
      "properties": {
        "level": {
          "type": "string",
          "description": "How authoritative the source is for the relevant workflow.",
          "enum": [
            "official_primary",
            "official_secondary",
            "public_legal_aid",
            "recognized_secondary",
            "community_reference",
            "unknown"
          ]
        },
        "issuing_body": {
          "type": "string",
          "description": "Entity that published or maintains the source."
        },
        "is_source_of_truth": {
          "type": "boolean",
          "description": "Whether this source should be treated as the controlling source for its workflow."
        },
        "authority_notes": {
          "type": "string",
          "description": "Notes about authority, limitations, or relationship to other sources."
        }
      }
    },
    "dates": {
      "type": "object",
      "description": "Dates used to judge freshness and review status.",
      "additionalProperties": false,
      "required": [
        "last_verified"
      ],
      "properties": {
        "published": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "description": "Date the source was published, if known."
        },
        "effective_from": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "description": "Effective date, if relevant and known."
        },
        "effective_through": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "description": "Last effective date, if the source has expired or been superseded."
        },
        "last_updated": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "description": "Date the source was last updated by the publisher, if known."
        },
        "last_verified": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "description": "Date Pro-One last verified the source content, or null for an unverified placeholder."
        }
      }
    },
    "provenance": {
      "type": "object",
      "description": "Practical source-content provenance used for freshness checks and future migrations.",
      "additionalProperties": false,
      "required": [
        "source_content_version",
        "content_hash",
        "superseded_by_source_id"
      ],
      "properties": {
        "source_content_version": {
          "type": [
            "string",
            "null"
          ],
          "description": "Publisher-provided version, revision, edition, or release identifier, when available."
        },
        "content_hash": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "Optional SHA-256 hash of captured source content, prefixed with sha256:."
        },
        "superseded_by_source_id": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/recordId"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source record that supersedes this one, if known."
        },
        "provenance_notes": {
          "type": "string"
        }
      }
    },
    "access": {
      "type": "object",
      "description": "How the source can be accessed.",
      "additionalProperties": false,
      "required": [
        "is_free",
        "requires_login",
        "format"
      ],
      "properties": {
        "is_free": {
          "type": "boolean",
          "description": "Whether the source can be accessed without payment."
        },
        "requires_login": {
          "type": "boolean",
          "description": "Whether the source requires an account or login."
        },
        "format": {
          "type": "string",
          "description": "Primary source format.",
          "enum": [
            "html",
            "pdf",
            "docx",
            "json",
            "xml",
            "text",
            "other"
          ]
        },
        "access_notes": {
          "type": "string",
          "description": "Notes about access, downloads, or availability."
        }
      }
    },
    "rights": {
      "type": "object",
      "description": "Reuse and licensing information.",
      "additionalProperties": false,
      "required": [
        "reuse_status"
      ],
      "properties": {
        "reuse_status": {
          "type": "string",
          "description": "Whether Pro-One can reuse, quote, summarize, or link to the source.",
          "enum": [
            "public_domain",
            "open_license",
            "link_only",
            "permission_required",
            "unknown"
          ]
        },
        "license": {
          "type": [
            "string",
            "null"
          ],
          "description": "License name if known."
        },
        "terms_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri",
          "description": "Terms, license, or use-policy URL if available."
        },
        "rights_notes": {
          "type": "string",
          "description": "Notes about reuse limits or uncertainty."
        }
      }
    },
    "review": {
      "$ref": "common.schema.json#/$defs/reviewInformation"
    },
    "workflow_fit": {
      "type": "object",
      "description": "How this source may be used in Pro-One workflows.",
      "additionalProperties": false,
      "required": [
        "topics",
        "workflow_ids",
        "risk_level"
      ],
      "properties": {
        "topics": {
          "type": "array",
          "description": "Legal topics the source relates to.",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "workflow_ids": {
          "type": "array",
          "description": "Workflow identifiers this source may support.",
          "items": {
            "$ref": "common.schema.json#/$defs/recordId"
          },
          "uniqueItems": true
        },
        "risk_level": {
          "$ref": "common.schema.json#/$defs/riskLevel"
        },
        "limitations": {
          "type": "array",
          "description": "Known limits on use.",
          "items": {
            "type": "string"
          }
        },
        "not_for": {
          "type": "array",
          "description": "Workflows or uses this source should not support.",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "citation": {
      "type": "object",
      "description": "Citation and retrieval metadata.",
      "additionalProperties": false,
      "required": [
        "preferred_citation",
        "retrieved_at"
      ],
      "properties": {
        "preferred_citation": {
          "type": "string",
          "description": "Preferred citation or source label."
        },
        "retrieved_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "description": "Date the source was actually retrieved, or null for an unretrieved placeholder."
        },
        "archive_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri",
          "description": "Archived copy URL if available."
        }
      }
    },
    "notes": {
      "type": "string",
      "description": "Additional notes."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "supported"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "review": {
            "properties": {
              "status": {
                "const": "approved"
              },
              "review_scope": {
                "allOf": [
                  { "contains": { "const": "schema" } },
                  { "contains": { "const": "source_authority" } },
                  { "contains": { "const": "source_freshness" } },
                  { "contains": { "const": "jurisdiction" } }
                ]
              }
            },
            "required": [
              "status",
              "review_scope"
            ]
          },
          "dates": {
            "required": [
              "last_verified"
            ],
            "properties": {
              "last_verified": {
                "type": "string"
              }
            }
          },
          "citation": {
            "properties": {
              "retrieved_at": {
                "type": "string"
              }
            },
            "required": [
              "retrieved_at"
            ]
          }
        }
      }
    }
  ]
}
