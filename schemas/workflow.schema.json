{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workflow.schema.json",
  "title": "Pro-One Workflow Definition",
  "description": "Schema for defining supported legal-information workflows, boundaries, source needs, outputs, review status, and safety limits.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schema_version",
    "record_version",
    "last_modified",
    "title",
    "description",
    "status",
    "user_types",
    "legal_area",
    "topics",
    "jurisdiction",
    "scope",
    "sources",
    "intake",
    "process",
    "outputs",
    "safety",
    "review",
    "evaluation"
  ],
  "properties": {
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_fields",
        "selectors",
        "intake_bindings"
      ],
      "properties": {
        "required_fields": {
          "type": "array",
          "items": {
            "enum": [
              "country",
              "state",
              "user_type",
              "matter_type",
              "court",
              "document_title",
              "form_number",
              "role"
            ]
          }
        },
        "selectors": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "matter_type",
              "court",
              "document_title",
              "form_number",
              "role"
            ]
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "intake_bindings": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "state",
              "court",
              "document_title",
              "form_number",
              "role",
              "user_type",
              "matter_type",
              "country"
            ]
          }
        }
      }
    },
    "response_constraints": {
      "description": "Explicit planning gaps; never interpreted from source prose or treated as negative legal rules.",
      "type": "object", "additionalProperties": false,
      "required": ["support_gaps"],
      "properties": {
        "support_gaps": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["code", "description", "propositions", "withhold_claims", "blocks_public_grounding", "prohibited_conclusions"],
            "properties": {
              "code": { "$ref": "common.schema.json#/$defs/recordId" },
              "description": { "type": "string", "minLength": 1 },
              "propositions": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/recordId" } },
              "withhold_claims": { "type": "boolean" },
              "blocks_public_grounding": { "type": "boolean" },
              "prohibited_conclusions": { "type": "array", "items": { "type": "string", "minLength": 1 } }
            }
          }
        }
      }
    },
    "id": {
      "$ref": "common.schema.json#/$defs/recordId"
    },
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "record_version": {
      "$ref": "common.schema.json#/$defs/recordVersion"
    },
    "last_modified": {
      "$ref": "common.schema.json#/$defs/lastModified"
    },
    "title": {
      "type": "string",
      "description": "Human-readable workflow title."
    },
    "description": {
      "type": "string",
      "description": "Short explanation of the workflow and who it helps."
    },
    "status": {
      "$ref": "common.schema.json#/$defs/maturityStatus"
    },
    "user_types": {
      "type": "array",
      "description": "User groups this workflow is designed to help.",
      "items": {
        "type": "string",
        "enum": [
          "self_represented_individual",
          "small_business_owner",
          "small_business_operator",
          "nonprofit_operator",
          "legal_aid_helper",
          "other"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "legal_area": {
      "type": "string",
      "description": "Primary legal area for the workflow."
    },
    "topics": {
      "type": "array",
      "description": "Specific topics covered by the workflow.",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "jurisdiction": {
      "$ref": "common.schema.json#/$defs/jurisdiction"
    },
    "scope": {
      "type": "object",
      "description": "What the workflow may and may not do.",
      "additionalProperties": false,
      "required": [
        "purpose",
        "legal_information_only",
        "includes",
        "excludes"
      ],
      "properties": {
        "purpose": {
          "type": "string",
          "description": "Plain-language purpose of the workflow."
        },
        "legal_information_only": {
          "type": "boolean",
          "const": true,
          "description": "This workflow provides legal information, not legal advice."
        },
        "includes": {
          "type": "array",
          "description": "Tasks or explanations the workflow may include.",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "excludes": {
          "type": "array",
          "description": "Tasks or decisions the workflow must not handle.",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "assumptions": {
          "type": "array",
          "description": "Assumptions that must be true for the workflow to fit.",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "sources": {
      "type": "object",
      "description": "Source requirements for the workflow.",
      "additionalProperties": false,
      "required": [
        "required_source_ids",
        "source_review_required"
      ],
      "properties": {
        "required_source_ids": {
          "type": "array",
          "description": "Approved or proposed source IDs required for this workflow.",
          "items": {
            "$ref": "common.schema.json#/$defs/recordId"
          },
          "uniqueItems": true
        },
        "optional_source_ids": {
          "type": "array",
          "description": "Additional source IDs that may support the workflow.",
          "items": {
            "$ref": "common.schema.json#/$defs/recordId"
          },
          "uniqueItems": true
        },
        "source_review_required": {
          "type": "boolean",
          "description": "Whether source review is required before the workflow can be supported."
        },
        "source_notes": {
          "type": "string",
          "description": "Notes about source coverage, gaps, or limits."
        }
      }
    },
    "intake": {
      "type": "object",
      "description": "Information the workflow may ask from the user.",
      "additionalProperties": false,
      "required": [
        "required_inputs",
        "optional_inputs",
        "excluded_inputs",
        "collects_sensitive_data"
      ],
      "properties": {
        "required_inputs": {
          "type": "array",
          "description": "Information required to decide whether the workflow fits.",
          "items": {
            "type": "string"
          }
        },
        "optional_inputs": {
          "type": "array",
          "description": "Information that may improve usefulness but is not required.",
          "items": {
            "type": "string"
          }
        },
        "excluded_inputs": {
          "type": "array",
          "description": "Information this workflow should not request.",
          "items": {
            "type": "string"
          }
        },
        "collects_sensitive_data": {
          "type": "boolean",
          "description": "Whether the workflow collects sensitive personal, financial, health, immigration, or court-case information."
        },
        "data_minimization_notes": {
          "type": "string",
          "description": "How the workflow avoids collecting unnecessary data."
        }
      }
    },
    "process": {
      "type": "object",
      "description": "Court, agency, or legal process coverage.",
      "additionalProperties": false,
      "required": [
        "process_step_ids",
        "summary_steps",
        "deadline_handling"
      ],
      "properties": {
        "process_step_ids": {
          "type": "array",
          "description": "Process-step identifiers connected to this workflow.",
          "items": {
            "$ref": "common.schema.json#/$defs/recordId"
          },
          "uniqueItems": true
        },
        "summary_steps": {
          "type": "array",
          "description": "Plain-language process steps the workflow may explain.",
          "items": {
            "type": "string"
          }
        },
        "deadline_handling": {
          "$ref": "common.schema.json#/$defs/deadlineHandling"
        },
        "process_notes": {
          "type": "string",
          "description": "Notes about process limits or needed review."
        }
      }
    },
    "outputs": {
      "type": "object",
      "description": "Outputs this workflow may generate.",
      "additionalProperties": false,
      "required": [
        "allowed_outputs",
        "prohibited_outputs",
        "document_types"
      ],
      "properties": {
        "allowed_outputs": {
          "type": "array",
          "description": "Output types this workflow may provide.",
          "items": {
            "type": "string",
            "enum": [
              "information_summary",
              "step_by_step_guide",
              "checklist",
              "document_outline",
              "user_confirmed_draft",
              "form_guidance",
              "citation_summary",
              "referral_prompt"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "prohibited_outputs": {
          "type": "array",
          "description": "Output types this workflow must not provide.",
          "items": {
            "type": "string",
            "enum": [
              "legal_opinion",
              "guaranteed_outcome",
              "deadline_calculation",
              "case_strategy",
              "final_filing_decision",
              "emergency_advice",
              "unsupported_document"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "document_types": {
          "type": "array",
          "description": "Document types this workflow may discuss, outline, or draft if allowed.",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "output_notes": {
          "type": "string",
          "description": "Notes about output limits, review reminders, or document handling."
        }
      }
    },
    "safety": {
      "type": "object",
      "description": "Risk, refusal, and human-help rules.",
      "additionalProperties": false,
      "required": [
        "risk_level",
        "escalation_triggers",
        "refusal_triggers",
        "required_warnings"
      ],
      "properties": {
        "risk_level": {
          "$ref": "common.schema.json#/$defs/riskLevel"
        },
        "escalation_triggers": {
          "type": "array",
          "description": "Signals that the user should be directed toward legal aid, court help, or a lawyer.",
          "items": {
            "type": "string"
          }
        },
        "refusal_triggers": {
          "type": "array",
          "description": "Signals that the workflow should refuse or narrow the request.",
          "items": {
            "type": "string"
          }
        },
        "required_warnings": {
          "type": "array",
          "description": "Warnings or limits that must appear in user-facing responses.",
          "items": {
            "type": "string"
          }
        },
        "safety_notes": {
          "type": "string",
          "description": "Additional safety notes."
        }
      }
    },
    "review": {
      "$ref": "common.schema.json#/$defs/reviewInformation"
    },
    "evaluation": {
      "$ref": "common.schema.json#/$defs/evaluationRequirements"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "supported"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "review": {
            "properties": {
              "status": {
                "const": "approved"
              },
              "review_scope": {
                "allOf": [
                  {
                    "contains": {
                      "const": "schema"
                    }
                  },
                  {
                    "contains": {
                      "const": "jurisdiction"
                    }
                  },
                  {
                    "contains": {
                      "const": "legal_information_boundary"
                    }
                  },
                  {
                    "contains": {
                      "const": "safety"
                    }
                  },
                  {
                    "contains": {
                      "const": "evaluation"
                    }
                  }
                ]
              }
            },
            "required": [
              "status",
              "review_scope"
            ]
          },
          "evaluation": {
            "properties": {
              "required_evaluation_fixture_ids": {
                "minItems": 1
              }
            },
            "required": [
              "required_evaluation_fixture_ids"
            ]
          },
          "sources": {
            "properties": {
              "required_source_ids": {
                "minItems": 1
              },
              "source_review_required": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "supported"
          },
          "intake": {
            "properties": {
              "collects_sensitive_data": {
                "const": true
              }
            },
            "required": [
              "collects_sensitive_data"
            ]
          }
        },
        "required": [
          "status",
          "intake"
        ]
      },
      "then": {
        "properties": {
          "review": {
            "properties": {
              "review_scope": {
                "contains": {
                  "const": "privacy"
                }
              }
            },
            "required": [
              "review_scope"
            ]
          }
        }
      }
    }
  ]
}
