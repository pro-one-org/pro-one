{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "legal-rule.schema.json",
  "title": "Pro-One Legal Rule",
  "description": "Schema for defining source-backed legal rule statements, jurisdiction limits, authority, effective dates, workflow fit, document fit, risk notes, review status, and evaluation requirements.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schema_version",
    "record_version",
    "last_modified",
    "title",
    "description",
    "status",
    "rule_type",
    "jurisdiction",
    "source_support",
    "rule_statement",
    "rule_scope",
    "workflow_fit",
    "process_step_fit",
    "document_fit",
    "dates",
    "user_support",
    "risk",
    "review",
    "evaluation"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/recordId"
    },
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "record_version": {
      "$ref": "common.schema.json#/$defs/recordVersion"
    },
    "last_modified": {
      "$ref": "common.schema.json#/$defs/lastModified"
    },
    "title": {
      "type": "string",
      "description": "Human-readable title for the legal rule."
    },
    "description": {
      "type": "string",
      "description": "Plain-language explanation of what this legal-rule record covers."
    },
    "status": {
      "$ref": "common.schema.json#/$defs/maturityStatus"
    },
    "rule_type": {
      "type": "string",
      "description": "General category of legal rule.",
      "enum": [
        "eligibility_rule",
        "filing_rule",
        "service_rule",
        "notice_rule",
        "deadline_rule",
        "form_rule",
        "fee_rule",
        "fee_waiver_rule",
        "hearing_rule",
        "evidence_rule",
        "discovery_rule",
        "subpoena_rule",
        "response_rule",
        "appeal_or_review_rule",
        "agency_rule",
        "business_rule",
        "contract_rule",
        "privacy_rule",
        "safety_rule",
        "other"
      ]
    },
    "jurisdiction": {
      "type": "object",
      "description": "Jurisdiction, court, agency, or locality where the legal rule may apply. This structure permits an intentionally unknown jurisdiction and therefore is distinct from the shared known-jurisdiction definition.",
      "additionalProperties": false,
      "required": [
        "country",
        "state",
        "locality",
        "court",
        "agency",
        "jurisdiction_required",
        "jurisdiction_notes"
      ],
      "properties": {
        "country": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/countryCode"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "type": [
            "string",
            "null"
          ]
        },
        "locality": {
          "type": [
            "string",
            "null"
          ]
        },
        "court": {
          "type": [
            "string",
            "null"
          ]
        },
        "agency": {
          "type": [
            "string",
            "null"
          ]
        },
        "jurisdiction_required": {
          "type": "boolean",
          "description": "Whether Pro-One must identify jurisdiction before using this rule in a user-facing response."
        },
        "jurisdiction_notes": {
          "type": "string",
          "description": "Notes about jurisdiction, venue, forum, agency, or locality limits."
        }
      }
    },
    "source_support": {
      "type": "object",
      "description": "Sources supporting the legal-rule statement.",
      "additionalProperties": false,
      "required": [
        "required_source_ids",
        "optional_source_ids",
        "source_quotes_allowed",
        "source_review_required",
        "source_notes"
      ],
      "properties": {
        "required_source_ids": {
          "type": "array",
          "description": "Source identifiers required before this rule may be used.",
          "items": {
            "$ref": "common.schema.json#/$defs/recordId"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "optional_source_ids": {
          "type": "array",
          "description": "Additional source identifiers that may help explain or verify the rule.",
          "items": {
            "$ref": "common.schema.json#/$defs/recordId"
          },
          "uniqueItems": true
        },
        "source_quotes_allowed": {
          "type": "boolean",
          "description": "Whether short source quotations may be used when allowed by rights and citation rules."
        },
        "source_review_required": {
          "type": "boolean",
          "description": "Whether source review is required before this rule is used."
        },
        "source_notes": {
          "type": "string",
          "description": "Notes about source authority, source limitations, or source freshness."
        }
      }
    },
    "rule_statement": {
      "type": "object",
      "description": "The legal-rule statement and related plain-language explanation.",
      "additionalProperties": false,
      "required": [
        "canonical_statement",
        "plain_language_statement",
        "must_not_overstate",
        "user_facing_allowed"
      ],
      "properties": {
        "canonical_statement": {
          "type": "string",
          "description": "Controlled rule statement based on reviewed sources."
        },
        "plain_language_statement": {
          "type": "string",
          "description": "Plain-language version of the rule statement."
        },
        "must_not_overstate": {
          "type": "array",
          "description": "Claims Pro-One must not make when using this rule.",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "user_facing_allowed": {
          "type": "boolean",
          "description": "Whether this rule may appear in user-facing responses after review."
        },
        "rule_statement_notes": {
          "type": "string",
          "description": "Notes about wording, limits, and safe phrasing."
        }
      }
    },
    "rule_scope": {
      "type": "object",
      "description": "Scope and limits of the legal rule.",
      "additionalProperties": false,
      "required": [
        "applies_to",
        "does_not_apply_to",
        "requires_user_facts",
        "requires_source_check"
      ],
      "properties": {
        "applies_to": {
          "type": "array",
          "description": "Situations where this legal rule may apply.",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "does_not_apply_to": {
          "type": "array",
          "description": "Situations where this legal rule should not be used.",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "requires_user_facts": {
          "type": "array",
          "description": "User facts needed before the rule can be applied or explained.",
          "items": {
            "type": "string"
          }
        },
        "requires_source_check": {
          "type": "boolean",
          "description": "Whether Pro-One must check source currency before using this rule."
        },
        "scope_notes": {
          "type": "string",
          "description": "Additional scope notes."
        }
      }
    },
    "workflow_fit": {
      "type": "object",
      "description": "Workflows where this rule may be used.",
      "additionalProperties": false,
      "required": [
        "supported_workflow_ids",
        "excluded_workflow_ids",
        "workflow_notes"
      ],
      "properties": {
        "supported_workflow_ids": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/recordId"
          },
          "uniqueItems": true
        },
        "excluded_workflow_ids": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/recordId"
          },
          "uniqueItems": true
        },
        "workflow_notes": {
          "type": "string"
        }
      }
    },
    "process_step_fit": {
      "type": "object",
      "description": "Process steps where this rule may be used.",
      "additionalProperties": false,
      "required": [
        "supported_process_step_ids",
        "excluded_process_step_ids",
        "process_step_notes"
      ],
      "properties": {
        "supported_process_step_ids": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/recordId"
          },
          "uniqueItems": true
        },
        "excluded_process_step_ids": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/recordId"
          },
          "uniqueItems": true
        },
        "process_step_notes": {
          "type": "string"
        }
      }
    },
    "document_fit": {
      "type": "object",
      "description": "Legal documents where this rule may be used.",
      "additionalProperties": false,
      "required": [
        "supported_document_ids",
        "supported_document_types",
        "excluded_document_ids",
        "document_notes"
      ],
      "properties": {
        "supported_document_ids": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/recordId"
          },
          "uniqueItems": true
        },
        "supported_document_types": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "court_form",
              "pleading",
              "complaint",
              "petition",
              "answer_or_response",
              "motion",
              "motion_response",
              "reply",
              "declaration_or_affidavit",
              "exhibit",
              "certificate_of_service",
              "subpoena",
              "notice",
              "discovery_request",
              "discovery_response",
              "interrogatories",
              "requests_for_production",
              "requests_for_admission",
              "objection",
              "demand_letter",
              "settlement_document",
              "contract_or_agreement",
              "agency_application",
              "business_document",
              "compliance_checklist",
              "filing_packet",
              "service_packet",
              "hearing_packet",
              "other"
            ]
          },
          "uniqueItems": true
        },
        "excluded_document_ids": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/recordId"
          },
          "uniqueItems": true
        },
        "document_notes": {
          "type": "string"
        }
      }
    },
    "dates": {
      "type": "object",
      "description": "Dates relevant to the legal rule and its review.",
      "additionalProperties": false,
      "required": [
        "effective_on",
        "last_updated",
        "last_checked",
        "expires_on",
        "date_notes"
      ],
      "properties": {
        "effective_on": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "last_updated": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "last_checked": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "expires_on": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "date_notes": {
          "type": "string"
        }
      }
    },
    "user_support": {
      "type": "object",
      "description": "How Pro-One may use this rule to support users.",
      "additionalProperties": false,
      "required": [
        "allowed_support_modes",
        "prohibited_support_modes",
        "requires_plain_language",
        "requires_citation"
      ],
      "properties": {
        "allowed_support_modes": {
          "type": "array",
          "description": "Support modes where this rule may be used.",
          "items": {
            "$ref": "common.schema.json#/$defs/supportMode"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "prohibited_support_modes": {
          "type": "array",
          "description": "Support modes where this rule must not be used.",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "requires_plain_language": {
          "type": "boolean",
          "description": "Whether user-facing use must include plain-language explanation."
        },
        "requires_citation": {
          "type": "boolean",
          "description": "Whether user-facing use must include a source citation or source reference."
        },
        "user_support_notes": {
          "type": "string",
          "description": "Notes about user-facing support boundaries."
        }
      }
    },
    "exceptions_and_variations": {
      "type": "object",
      "description": "Exceptions, variations, and unresolved issues related to the rule.",
      "additionalProperties": false,
      "properties": {
        "known_exceptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "local_variations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unresolved_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "variation_notes": {
          "type": "string"
        }
      }
    },
    "risk": {
      "type": "object",
      "description": "Risk handling for this legal rule.",
      "additionalProperties": false,
      "required": [
        "risk_level",
        "risk_triggers",
        "unsafe_uses",
        "safe_continuation_notes"
      ],
      "properties": {
        "risk_level": {
          "$ref": "common.schema.json#/$defs/riskLevel"
        },
        "risk_triggers": {
          "type": "array",
          "description": "Signals that require narrower support, urgent support, or additional caution.",
          "items": {
            "type": "string"
          }
        },
        "unsafe_uses": {
          "type": "array",
          "description": "Uses of the rule that Pro-One should not support.",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "safe_continuation_notes": {
          "type": "string",
          "description": "How Pro-One should keep helping safely when risks appear."
        }
      }
    },
    "review": {
      "$ref": "common.schema.json#/$defs/reviewInformation"
    },
    "evaluation": {
      "$ref": "common.schema.json#/$defs/evaluationRequirements"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes."
    },
    "source_passage_ids": {
      "$ref": "common.schema.json#/$defs/recordIdArray"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "supported"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "review": {
            "properties": {
              "status": {
                "const": "approved"
              },
              "review_scope": {
                "allOf": [
                  {
                    "contains": {
                      "const": "schema"
                    }
                  },
                  {
                    "contains": {
                      "const": "source_authority"
                    }
                  },
                  {
                    "contains": {
                      "const": "jurisdiction"
                    }
                  },
                  {
                    "contains": {
                      "const": "legal_information_boundary"
                    }
                  },
                  {
                    "contains": {
                      "const": "safety"
                    }
                  },
                  {
                    "contains": {
                      "const": "evaluation"
                    }
                  }
                ]
              }
            },
            "required": [
              "status",
              "review_scope"
            ]
          },
          "evaluation": {
            "properties": {
              "required_evaluation_fixture_ids": {
                "minItems": 1
              }
            },
            "required": [
              "required_evaluation_fixture_ids"
            ]
          },
          "source_support": {
            "properties": {
              "required_source_ids": {
                "minItems": 1
              },
              "source_review_required": {
                "const": true
              }
            }
          },
          "user_support": {
            "properties": {
              "requires_citation": {
                "const": true
              }
            }
          }
        }
      }
    }
  ]
}
