  "passages": {
    "b8e2acd029e941f7038a57996280e3": {
      "citation": "A.R.S. § 12-542",
      "source_id": "US-AZ:pi_limitations:ab955cf075cb",
      "authority_type": "statute",
      "text": "Except as provided in section 12-551 there shall be commenced and prosecuted within two years after the cause of action accrues, and not afterward, the following actions: 1. For injuries done to the person of another including causes of action for medical malpractice as defined in section 12-561.",
      "text_sha256": "313e1edbf7b7a3ca84ef929b54724c0940f24bf8be40c18b679ed901b8436032",
      "publisher_sha256": "29513120d481ec5432c4cc9f90d8f4cea212f6780f138bddb87981f34e5555b1",
      "retrieved_at": "2026-11-17T19:33:54.909148+00:00",
      "language": "en",
      "currentness": "unresolved"
    },
    "e743619df21ca3be9a8bfa0670909d": {
      "citation": "A.R.S. § 12-548",
      "source_id": "US-AZ:written_contract_limitations:7d29338070d1",
      "authority_type": "statute",
      "text": "A. An action for debt shall be commenced and prosecuted within six years after the cause of action accrues, and not afterward, if the indebtedness is evidenced by or founded on either of the following: 1. A contract in writing that is executed in this state. 2. A credit card as defined in section 13-2101, paragraph 3, subdivision (a).",
      "text_sha256": "f351d3ce7ec84e3411925eb0a6a385d2e617c215cc73739c0830565448858787",
      "publisher_sha256": "ce2c4c6010e702958ab41e2f8cb30494b39d90b57e38f08c6a31bed3a5bc8fe7",
      "retrieved_at": "2026-11-17T19:33:54.913667+00:00",
      "language": "en",
      "currentness": "unresolved"
    },
    "3be8a01cb8ac7227ecc78fab59dace": {
      "citation": "A.R.S. § 12-543",
      "source_id": "US-AZ:oral_contract_limitations:97dc61e8dea0",
      "authority_type": "statute",
      "text": "There shall be commenced and prosecuted within three years after the cause of action accrues, and not afterward, the following actions: 1. For debt where the indebtedness is not evidenced by a contract in writing.",
      "text_sha256": "e12eb90b73b6d31324bdc60217783cf11e98c2c16e0990f0f37bc64f5b69d882",
      "publisher_sha256": "118ee5349b607512dc5719da485e388ae0426f0551d7cab6a36eda414baaf269",
      "retrieved_at": "2026-11-17T19:33:54.914662+00:00",
      "language": "en",
      "currentness": "unresolved"
    },
    "8e28ca8905c3b14a574e25e2660147": {
      "citation": "A.R.S. § 12-2505",
      "source_id": "US-AZ:fault:9c2c05fa45d0",
      "authority_type": "statute",
      "language": "en",
      "text": "A. The defense of contributory negligence or of assumption of risk is in all cases a question of fact and shall at all times be left to the jury. If the jury applies either defense, the claimant's action is not barred, but the full damages shall be reduced in proportion to the relative degree of the claimant's fault which is a proximate cause of the injury or death, if any. There is no right to comparative negligence in favor of any claimant who has intentionally, wilfully or wantonly caused or contributed to the injury or wrongful death. B. In this section, \"claimant's fault\" includes the fault imputed or attributed to a claimant by operation of law, if any.",
      "text_sha256": "9b53f5d565435da485be389b97ce8b32fd0fb3e9104dc07c72a12d7f3330f107",
      "publisher_sha256": "2d2a9c95b28164c1298cb13671c9e47f799280a465850e98d16d9d8f2411384e",
      "retrieved_at": "2026-11-17T20:50:32.546862+00:00",
      "currentness": "unresolved"
    },
    "6c1fcef7aa0a7d28ad8095d1a17883": {
      "source_id": "US-AZ:consumerLaw:bd853ac9056b",
      "authority_type": "statute",
      "citation": "A.R.S. § 44-1522",
      "text": "A. The act, use or employment by any person of any deception, deceptive or unfair act or practice, fraud, false pretense, false promise, misrepresentation, or concealment, suppression or omission of any material fact with intent that others rely on such concealment, suppression or omission, in connection with the sale or advertisement of any merchandise whether or not any person has in fact been misled, deceived or damaged thereby, is declared to be an unlawful practice. B. The violation of chapter 9, article 16 or chapter 19, article 1 of this title is declared to be an unlawful practice and subject to enforcement under this article. C. It is the intent of the legislature, in construing subsection A, that the courts may use as a guide interpretations given by the federal trade commission and the federal courts to 15 United States Code sections 45, 52 and 55(a)(1).",
      "text_sha256": "a6e5b8e69029ce24e0291649806077b01ae88e81e6ed3aacfe55c7b5a9a0116b",
      "publisher_sha256": "2bf047a9791fc59d85e509342889ca58b1b066fa1d0c558c90f0dc27ed2d033a",
      "retrieved_at": "2026-11-17T21:03:50.904224+00:00",
      "currentness": "unresolved",
      "language": "en"
    },
    "528952cc4adda409c01afa28049a37": {
      "source_id": "US-AZ:contract_formation:889e61772e35",
      "authority_type": "statute",
      "citation": "A.R.S. § 47-2204",
      "text": "A contract for sale of goods may be made in any manner sufficient to show agreement, including conduct by both parties which recognizes the existence of such a contract.",
      "text_sha256": "9c77be9f087223530e0d86a71047d66373e3a4889718dffe0aff6b1ded1679b9",
      "publisher_sha256": "0ebd3d6fa5e54707700dce8e9c8ed8712d80fc676837501e9d1e2d7461a9cdf8",
      "retrieved_at": "2026-11-18T15:14:25.178656+00:00",
      "currentness": "unresolved",
      "language": "en"
    },
    "3f089867f83fa7ee08a3705b7614d9": {
      "source_id": "US-AZ:commencement:973555b4dfa6",
      "authority_type": "court_rule",
      "citation": "Ariz. R. Civ. P. 3",
      "text": "A civil action is commenced by filing a complaint with the court.",
      "text_sha256": "4345c2469f24d6e60fd993cb2587c8049f27a75270937dfa9b4748be88f154d9",
      "publisher_sha256": "022194c52c2c51ff885f5dba4d43af7789052509f43c7295713d2c57064c64a8",
      "retrieved_at": "2026-11-18T20:45:33.808787+00:00",
      "currentness": "historical",
      "language": "en",
      "edition": "Supreme Court Order R-16-0010, effective January 1, 2017",
      "court": "Arizona Superior Court"
    },
    "828c4e64929c8680276e8009d45907": {
      "source_id": "US-AZ:negligence_elements:d2da50ae7685",
      "authority_type": "opinion",
      "citation": "Henke v. Hospital Development of West Phoenix, Inc., No. CV-24-0259-PR, ¶ 23 (Ariz. Oct. 22, 2025)",
      "text": "“In medical malpractice actions, as in all negligence actions, the plaintiff must prove the existence of a duty, a breach of that duty, causation, and damages.” Seisinger v. Siebel, 220 Ariz. 85, 94 ¶ 32 (2009).",
      "text_sha256": "cb12b2fbbc0879e4284ad9da69e10323602e552f567742d9eaebeb55eb0914ab",
      "publisher_sha256": "ade982671e4d4eefff0935b6822c276d06a56f1869c82f97646ed6d9e3058b43",
      "retrieved_at": "2026-11-19T13:54:35.508947+00:00",
      "currentness": "historical",
      "language": "en",
      "edition": "Court opinion of 2025-10-22",
      "court": "Supreme Court of Arizona",
      "decision_date": "2025-10-22",
      "opinion_role": "majority",
      "procedural_posture": "Medical malpractice action. Trial judgment reversed and remanded; intermediate decision vacated."
    },
    "b7ed6c5d93df53dfdd22193a565c60": {
      "source_id": "US-AZ:wageLaw:e584dc736354",
      "authority_type": "statute",
      "citation": "A.R.S. § 23-353(A)–(B)",
      "text": "A. When an employee is discharged from the service of an employer, he shall be paid wages due him within seven working days or the end of the next regular pay period, whichever is sooner. B. When an employee quits the service of an employer he shall be paid in the usual manner all wages due him no later than the regular payday for the pay period during which the termination occurred. If requested by the employee, such wages shall be paid by mail.",
