  "passages": {
    "c056beca21265af1bb173fcd7a100a": {
      "citation": "10 Del. C. § 8119",
      "source_id": "US-DE:pi_limitations:d66a8c19d8c6",
      "authority_type": "statute",
      "text": "No action for the recovery of damages upon a claim for alleged personal injuries shall be brought after the expiration of 2 years from the date upon which it is claimed that such alleged injuries were sustained; subject, however, to the provisions of § 8127 of this title.",
      "text_sha256": "17295de17c048c23e5f96d2c4d712fa7d875bc036fb86ff54b845eb03478c389",
      "publisher_sha256": "fe416bed3788d1b09090d8f5423c90fcbe207652f11d300c7a09b2dfd0fc1f20",
      "retrieved_at": "2026-11-17T19:33:55.515257+00:00",
      "language": "en",
      "currentness": "unresolved"
    },
    "873e38b7f1f0c2567781262f081ec5": {
      "citation": "10 Del. C. § 8132",
      "source_id": "US-DE:fault:096caca3b135",
      "authority_type": "statute",
      "language": "en",
      "text": "§ 8132. Comparative negligence. In all actions brought to recover damages for negligence which results in death or injury to person or property, the fact that the plaintiff may have been contributorily negligent shall not bar a recovery by the plaintiff or the plaintiff’s legal representative where such negligence was not greater than the negligence of the defendant or the combined negligence of all defendants against whom recovery is sought, but any damages awarded shall be diminished in proportion to the amount of negligence attributed to the plaintiff.",
      "text_sha256": "dd4b056832154897d189b5452699c1f318efdf2fe2dd14a8804ae8967c36c61b",
      "publisher_sha256": "fe416bed3788d1b09090d8f5423c90fcbe207652f11d300c7a09b2dfd0fc1f20",
      "retrieved_at": "2026-11-17T20:50:32.617194+00:00",
      "currentness": "unresolved"
    }
  },
