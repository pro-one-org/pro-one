  "passages": {
    "fe56625550fe2a628953cac736d2ba": {
      "citation": "RCW 4.16.080",
      "source_id": "US-WA:pi_limitations:80219e78abae",
      "authority_type": "statute",
      "text": "The following actions shall be commenced within three years: (1) An action for waste or trespass upon real property; (2) An action for taking, detaining, or injuring personal property, including an action for the specific recovery thereof, or for any other injury to the person or rights of another not hereinafter enumerated;",
      "text_sha256": "7d7b98fcb8ac0910eb9d4bdfb86d31fe21e3799910fbedac41dee1741443d0a9",
      "publisher_sha256": "f13daab7bf1ea811823033b27fad8ed88ed36a71ff085e8f74090ebf1b333bef",
      "retrieved_at": "2026-11-17T19:34:04.943224+00:00",
      "language": "en",
      "currentness": "unresolved"
    },
    "f4b6212031e4bcd4d3f0058bab008d": {
      "citation": "RCW 4.16.040",
      "source_id": "US-WA:written_contract_limitations:da82279f40aa",
      "authority_type": "statute",
      "text": "The following actions shall be commenced within six years: (1) An action upon a contract in writing, or liability express or implied arising out of a written agreement, except as provided for in RCW 64.04.007(2).",
      "text_sha256": "2e8af4821e0e88f0280b139003ced4771dd25b3248bf75175c104858f6badd95",
      "publisher_sha256": "13607a518daaa7dbf60a96d4ffecc96425813d69ddd49a07fa14420a823c6593",
      "retrieved_at": "2026-11-17T19:34:05.588586+00:00",
      "language": "en",
      "currentness": "unresolved"
    },
    "28bb9fbee471492a63bd9f843a2ab7": {
      "citation": "RCW 4.22.005",
      "source_id": "US-WA:fault:b08a13af8aed",
      "authority_type": "statute",
      "language": "en",
      "text": "In an action based on fault seeking to recover damages for injury or death to person or harm to property, any contributory fault chargeable to the claimant diminishes proportionately the amount awarded as compensatory damages for an injury attributable to the claimant's contributory fault, but does not bar recovery. This rule applies whether or not under prior law the claimant's contributory fault constituted a defense or was disregarded under applicable legal doctrines, such as last clear chance.",
      "text_sha256": "24048d8340ca820a6343b721a99cb13a5d3704e7541522e36ceb67ca836af47c",
      "publisher_sha256": "9f5dadec64a3eed7319b66cd911969a56427efb014c74495cb87957925eeb6d4",
      "retrieved_at": "2026-11-17T20:50:36.900981+00:00",
      "currentness": "unresolved"
    },
    "c818bab7d9c22ef7022c3cf145bf85": {
      "source_id": "US-WA:consumerLaw:0981a560a957",
      "authority_type": "statute",
      "citation": "RCW 19.86.020",
      "text": "Unfair methods of competition and unfair or deceptive acts or practices in the conduct of any trade or commerce are hereby declared unlawful.",
      "text_sha256": "d9724ec8ba7d7cbd951b81c03cce7fab764c296b26eb16baf60e626e6fbce7ab",
      "publisher_sha256": "7d7587823d483a9d211ad59b477a0becf19bea30d35f72b6a5fba488159ebbd1",
      "retrieved_at": "2026-11-17T21:03:59.310590+00:00",
      "currentness": "unresolved",
      "language": "en"
    },
    "ee2eb98793388e17238a385756c69f": {
      "source_id": "US-WA:contract_formation:ad71feed8c8f",
      "authority_type": "statute",
      "citation": "RCW 62A.2-204",
      "text": "A contract for sale of goods may be made in any manner sufficient to show agreement, including conduct by both parties which recognizes the existence of such a contract.",
      "text_sha256": "9c77be9f087223530e0d86a71047d66373e3a4889718dffe0aff6b1ded1679b9",
      "publisher_sha256": "287722f8d11f59485eef48301842a12ecd40e53268ff8830f645596fa2a61503",
      "retrieved_at": "2026-11-18T15:14:36.135395+00:00",
      "currentness": "unresolved",
      "language": "en"
    }
  },
