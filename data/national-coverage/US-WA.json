  "passages": {
    "fe56625550fe2a628953cac736d2ba": {
      "citation": "RCW 4.16.080",
      "source_id": "US-WA:pi_limitations:80219e78abae",
      "authority_type": "statute",
      "text": "The following actions shall be commenced within three years: (1) An action for waste or trespass upon real property; (2) An action for taking, detaining, or injuring personal property, including an action for the specific recovery thereof, or for any other injury to the person or rights of another not hereinafter enumerated;",
      "text_sha256": "7d7b98fcb8ac0910eb9d4bdfb86d31fe21e3799910fbedac41dee1741443d0a9",
      "publisher_sha256": "f13daab7bf1ea811823033b27fad8ed88ed36a71ff085e8f74090ebf1b333bef",
      "retrieved_at": "2026-11-17T19:34:04.943224+00:00",
      "language": "en",
      "currentness": "unresolved"
    },
    "f4b6212031e4bcd4d3f0058bab008d": {
      "citation": "RCW 4.16.040",
      "source_id": "US-WA:written_contract_limitations:da82279f40aa",
      "authority_type": "statute",
      "text": "The following actions shall be commenced within six years: (1) An action upon a contract in writing, or liability express or implied arising out of a written agreement, except as provided for in RCW 64.04.007(2).",
      "text_sha256": "2e8af4821e0e88f0280b139003ced4771dd25b3248bf75175c104858f6badd95",
      "publisher_sha256": "13607a518daaa7dbf60a96d4ffecc96425813d69ddd49a07fa14420a823c6593",
      "retrieved_at": "2026-11-17T19:34:05.588586+00:00",
