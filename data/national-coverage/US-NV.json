  "passages": {
    "0ebfeb732d1808c0f185b2861fcab0": {
      "source_id": "US-NV:commencement:ee4d83b80f13",
      "citation": "Nev. R. Civ. P. 3",
      "authority_type": "court_rule",
      "language": "en",
      "text": "Rule 3. Commencing an Action A civil action is commenced by filing a complaint with the court.",
      "text_sha256": "403ae9d28c182ba9c09c3d9ae3c8ef9c40ae80a845659a183685d0b1d2908a33",
      "publisher_sha256": "99812c5ef90fa83a0b5ded17bb4f1649316b2e1c3cc48c9e91eaca63e2479065",
      "retrieved_at": "2026-11-17T20:14:25.244018+00:00",
      "currentness": "unresolved"
    },
    "0ef92d5eef0e92c3bdd52c0ed41b33": {
      "citation": "NRS 41.141(1)",
      "source_id": "US-NV:fault:2c2122cc907b",
      "authority_type": "statute",
      "language": "en",
      "text": "In any action to recover damages for death or injury to persons or for injury to property in which comparative negligence is asserted as a defense, the comparative negligence of the plaintiff or the plaintiff’s decedent does not bar a recovery if that negligence was not greater than the negligence or gross negligence of the parties to the action against whom recovery is sought.",
      "text_sha256": "ded824085a289e44e8558191d1f26b07754a534b8f4b8816ecc81a5b56acd00c",
      "publisher_sha256": "2f43bf05571a5c9df32060cd6419ae18e4b82ee277a6c8d404699140989ab786",
      "retrieved_at": "2026-11-17T20:50:35.281890+00:00",
      "currentness": "unresolved"
    },
    "e71c1b3e2bee5dbbc3daac3e9d714b": {
      "source_id": "US-NV:contract_formation:6166364556d7",
      "authority_type": "statute",
      "citation": "NRS 104.2204",
      "text": "A contract for sale of goods may be made in any manner sufficient to show agreement, including conduct by both parties which recognizes the existence of such a contract.",
      "text_sha256": "9c77be9f087223530e0d86a71047d66373e3a4889718dffe0aff6b1ded1679b9",
      "publisher_sha256": "1b54fb3a52b86d9034cb0b2ab53fa05cce7bd18f4aec38a4716477c0c25a4898",
      "retrieved_at": "2026-11-18T15:14:31.059769+00:00",
      "currentness": "unresolved",
      "language": "en"
    },
    "c73e9fdb8417c650b23c8d9be76acb": {
      "source_id": "US-NV:response:61312e40369c",
      "authority_type": "court_rule",
      "citation": "Nev. R. Civ. P. 12(a)(1)(A)",
      "text": "(1) In General. Unless another time is specified by Rule 4.2(c)(3)(E), this rule, or a statute, the time for serving a responsive pleading is as follows: (A) A defendant must serve an answer: (i) within 21 days after being served with the summons and complaint; or (ii) if the defendant has timely waived service under Rule 4.1, within 60 days after the request for a waiver was sent, or within 90 days after the request for a waiver was sent to the defendant outside of the United States.",
      "text_sha256": "d94a81dc38b408015cec07669b42c2378e1c8a012f8beb9379f25c07b463d05b",
      "publisher_sha256": "99812c5ef90fa83a0b5ded17bb4f1649316b2e1c3cc48c9e91eaca63e2479065",
      "retrieved_at": "2026-11-17T20:14:25.244018+00:00",
      "currentness": "unresolved",
      "language": "en"
    },
    "d7eb6372e1a1eeff32f9f2023c410f": {
      "source_id": "US-NV:service:724318dad321",
      "authority_type": "court_rule",
      "citation": "Nev. R. Civ. P. 4(c)(2)–(3)",
      "text": "(2) Service With a Copy of the Complaint. A summons must be served with a copy of the complaint. The plaintiff must furnish the necessary copies to the person who makes service. (3) By Whom. The summons and complaint may be served by the sheriff, or a deputy sheriff, of the county where the defendant is found or by any person who is at least 18 years old and not a party to the action.",
      "text_sha256": "36308ab9a42da69f8bf53631a9f8f712ae3b3593cb0ae0703022424fb3005f5b",
      "publisher_sha256": "99812c5ef90fa83a0b5ded17bb4f1649316b2e1c3cc48c9e91eaca63e2479065",
      "retrieved_at": "2026-11-17T20:14:25.244018+00:00",
      "currentness": "unresolved",
      "language": "en"
    },
    "3a2c37fc4d865b748aaec441495919": {
      "source_id": "US-NV:contract_damages:f6e59d3af29b",
      "authority_type": "statute",
      "citation": "NRS 104.2714",
      "text": "Where the buyer has accepted goods and given notification (subsection 3 of NRS 104.2607) the buyer may recover as damages for any nonconformity of tender the loss resulting in the ordinary course of events from the seller’s breach as determined in any manner which is reasonable. 2. The measure of damages for breach of warranty is the difference at the time and place of acceptance between the value of the goods accepted and the value they would have had if they had been as warranted, unless special circumstances show proximate damages of a different amount.",
      "text_sha256": "2e11d50e55467c1aa69d01aa837171fe6c4c5de993d97ce9235fb5ef81921cfa",
      "publisher_sha256": "1b54fb3a52b86d9034cb0b2ab53fa05cce7bd18f4aec38a4716477c0c25a4898",
      "retrieved_at": "2026-11-18T15:14:31.059769+00:00",
      "currentness": "unresolved",
      "language": "en"
    }
  },
