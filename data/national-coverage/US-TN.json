  "passages": {
    "227a670c0d4e066587addeb6420ee4": {
      "source_id": "US-TN:automated_contract_formation:0cdd4d7a90a8",
      "authority_type": "statute",
      "citation": "2001 Tenn. Pub. Acts, ch. 72, § 14",
      "text": "In an automated transaction, the following rules apply: (1) A contract may be formed by the interaction of electronic agents of the parties, even if no individual was aware of or reviewed the electronic agents' actions or the resulting terms and agreements. (2) A contract may be formed by the interaction of an electronic agent and an individual, acting on the individual's own behalf or for another person, including by an interaction in which the individual performs actions that the individual is free to refuse to perform and which the individual knows or has reason to know will cause the electronic agent to complete the transaction or performance. (3) The terms of the contract are determined by the substantive law applicable to it.",
      "text_sha256": "28f7e49bb52fd562f031118d0cdce197721fc349c0c5dcc23728a39c435c187a",
      "publisher_sha256": "56a019bc47663657f293ac9d4f1c50a4d5f4865bc8c433eb80b4d18cdd453cf0",
      "retrieved_at": "2026-11-18T20:42:58.076453+00:00",
      "currentness": "historical",
      "language": "en",
      "edition": "Approved April 11, 2001"
    },
    "4a5c8e4929cef5428063a7c86101d0": {
      "source_id": "US-TN:pi_limitations:d48319c355e2",
      "authority_type": "statute",
      "citation": "2015 Tenn. Pub. Acts ch. 388, §§ 1–2 (adopted Senate Amendment 1)",
      "text": "(a) (1) Except as provided in subdivision (a)(2), the following actions shall be commenced within one (1) year after the cause of action accrued: (A) Actions for libel, injuries to the person, false imprisonment, malicious prosecution, or breach of marriage promise; (B) Civil actions for compensatory or punitive damages, or both, brought under the federal civil rights statutes; and (C) Actions for statutory penalties. (2) A cause of action listed in subdivision (a)(1) shall be commenced within two (2) years after the cause of action accrued, if: (A) Criminal charges are brought against any person alleged to have caused or contributed to the injury; (B) The conduct, transaction, or occurrence that gives rise to the cause of action for civil damages is the subject of a criminal prosecution commenced within one (1) year by: (i) A law enforcement officer; (ii) A district attorney general; or (iii) A grand jury; and (C) The cause of action is brought by the person injured by the criminal conduct against the party prosecuted for such conduct. (3) This subsection (a) shall be strictly construed. SECTION 2. This act shall take effect July 1, 2015, the public welfare requiring it, and shall apply to causes of action accruing on or after that date.",
      "text_sha256": "dda3aacf4d682d6391527a986f4e534b370a3eab0ec9c6ec79192743c20141af",
      "publisher_sha256": "638d2586e0c9bf01357ab47e727455b58347f891d6eaaaf6adb68f77a1c3ffd2",
      "retrieved_at": "2026-11-20T15:47:20.105805+00:00",
      "currentness": "historical",
      "language": "en",
      "edition": "2015 enrolled Senate Bill 463 as amended, verified in the legislative passage history",
      "effective_from": "2015-07-01"
    }
  }
