    "6f2983ed0dafc79de13e0d861827cf": {
      "source_id": "US-OH:accrual:7a8acc1d100c",
      "authority_type": "statute",
      "citation": "Ohio Rev. Code § 2305.10(B)(1)",
      "text": "(B)(1) For purposes of division (A) of this section, a cause of action for bodily injury that is not described in division (B)(2), (3), (4), or (5) of this section and that is caused by exposure to hazardous or toxic chemicals, ethical drugs, or ethical medical devices accrues upon the date on which the plaintiff is informed by competent medical authority that the plaintiff has an injury that is related to the exposure, or upon the date on which by the exercise of reasonable diligence the plaintiff should have known that the plaintiff has an injury that is related to the exposure, whichever date occurs first.",
      "text_sha256": "85116ef4434034e746453ac00a83048d8d8685d3dc6dc1731207a93be76f9e7c",
