  "passages": {
    "ad108775f4ad9df81862a3cd47c997": {
      "source_id": "US-PA:contract_formation:a36c3152f580",
      "authority_type": "opinion",
      "citation": "Glover v. Junior, No. 9 EAP 2024, slip op. at 23 (Pa. Mar. 20, 2025)",
      "text": "General acquiescence to a course of conduct is not sufficient “mutual assent” to establish an oral contract; the parties must each know the terms of the contract and they must both assent to those terms, i.e., there must be an “offer” and an “acceptance” as defined by our common law contract principles.",
      "text_sha256": "2361bd90a0988e38d3d0306c6772b50c0e9f1f01979285d7e6b8abfd31b0af4c",
      "publisher_sha256": "fa9a1539ea27ab8a9dab5ae55b9f1c0efcf8cf62050ba87d652f681e0f63397d",
      "retrieved_at": "2026-11-18T20:40:10.884333+00:00",
      "currentness": "historical",
      "language": "en",
      "edition": "Court opinion of 2025-03-20",
      "court": "Supreme Court of Pennsylvania",
      "decision_date": "2025-03-20",
      "opinion_role": "majority",
      "procedural_posture": "Parentage appeal. The court affirmed on the ground of intent-based parentage."
    },
    "8a0025acf6d1ff898eba6b9a092d4f": {
      "source_id": "US-PA:fault:1deb88482607",
      "authority_type": "opinion",
      "citation": "Roverano v. John Crane, Inc., Nos. 26 and 27 EAP 2018 (Pa. Feb. 19, 2020)",
      "text": "(a) General rule.--In all actions brought to recover damages for negligence resulting in death or injury to person or property, the fact that the plaintiff may have been guilty of contributory negligence shall not bar a recovery by the plaintiff or his legal representative where such negligence was not greater than the causal negl igence of the defendant or defendants against whom recovery is sought, but any damages sustained by the plaintiff shall be diminished in proportion to the amount of negligence attributed to the plaintiff.",
      "text_sha256": "79ead704bfc07601ffb26d05e4511329b4a992db8ae76f5a016adecc7e4a82e3",
      "publisher_sha256": "a46e093f7c4d708e02a3f9467300473ff898970030796c21793310f8159f6239",
      "retrieved_at": "2026-11-19T18:57:48.976320+00:00",
      "currentness": "historical",
      "language": "en",
      "edition": "Court opinion of 2020-02-19",
      "court": "Supreme Court of Pennsylvania",
      "decision_date": "2020-02-19",
      "opinion_role": "majority",
      "procedural_posture": "Appeal concerning allocation in asbestos strict-liability litigation."
    },
    "b61af7070d51da2afde0ada0df7236": {
      "source_id": "US-PA:commencement:7aba154e4032",
      "authority_type": "court_rule",
      "citation": "231 Pa. Code Rule 1007",
      "text": "An action may be commenced by filing with the prothonotary: (1) a praecipe for a writ of summons, or (2) a complaint. Official Note For the form of the writ of summons, see Rule 1351. See Rule 205.5 governing the requirement for filing a cover sheet with the pleading commencing the action. Rule 2005(b) does not authorize the filing of a praecipe for a writ of summons if an unknown defendant is to be identified by a Doe designation.",
      "text_sha256": "c60bea32018f4107ac2fbae2f582152401c85f5024100363877397455f4d725a",
      "publisher_sha256": "80a147b441174e9c820f0b3193a72904329775394799ecdb207e1778e4bd0541",
      "retrieved_at": "2026-11-19T19:02:16.517447+00:00",
      "currentness": "unresolved",
      "language": "en",
      "court": "Pennsylvania Court of Common Pleas",
      "effective_from": "2019-04-01"
    },
    "b52c38abb3ca7fb3ab37109994a2bd": {
      "source_id": "US-PA:response:1200c936a18e",
      "authority_type": "court_rule",
      "citation": "231 Pa. Code Rule 1026(a)",
      "text": "(a) Except as provided by Rule 1042.4 or by subdivision (b) of this rule, every pleading subsequent to the complaint shall be filed within twenty days after service of the preceding pleading, but no pleading need be filed unless the preceding pleading contains a notice to defend or is endorsed with a notice to plead.",
      "text_sha256": "63dd0dd817e0d5bfb6b0f051c668766f2decbf84825cefd7be0a6d8f180652ea",
      "publisher_sha256": "36698c2bb03961ca951c29f27ad7ef96329a1158636832a4d171c0c5fd26dc85",
      "retrieved_at": "2026-11-19T19:42:59.773135+00:00",
      "currentness": "unresolved",
      "language": "en",
      "court": "Pennsylvania Court of Common Pleas"
    },
    "2f43030b53cdeab6ba9216f6a5ca70": {
      "source_id": "US-PA:service:ddf3c7115cf5",
      "authority_type": "court_rule",
      "citation": "231 Pa. Code Rule 402(a)",
      "text": "(a) Original process may be served (1) by handing a copy to the defendant; or (2) by handing a copy (i) at the residence of the defendant to an adult member of the family with whom he resides; but if no adult member of the family is found, then to an adult person in charge of such residence; or (ii) at the residence of the defendant to the clerk or manager of the hotel, inn, apartment house, boarding house or other place of lodging at which he resides; or (iii) at any office or usual place of business of the defendant to his agent or to the person for the time being in charge thereof.",
      "text_sha256": "dacb2385fe8c2fe5f6a720c5d15434fccb439c481d5f30daebfc0fd8743d9663",
      "publisher_sha256": "f403e3ec6bce46386edb1552ae97892bd7e4f04edb249e4f59d2b10f2b28ca81",
      "retrieved_at": "2026-11-20T15:21:03.127415+00:00",
      "currentness": "unresolved",
      "language": "en",
      "court": "Pennsylvania Court of Common Pleas"
    }
  },
