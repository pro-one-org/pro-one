  "passages": {
    "818449be80f0eccc8d071cd85e37ac": {
      "citation": "Idaho Code § 5-216",
      "source_id": "US-ID:written_contract_limitations:95d28668b4b5",
      "authority_type": "statute",
      "text": "5-216. Action on written contract. Within five (5) years: An action upon any contract, obligation or liability founded upon an instrument in writing. The limitations prescribed by this section shall never apply to actions in the name or for the benefit of the state and shall never be asserted nor interposed as a defense to any action in the name or for the benefit of the state although such limitations may have become fully operative as a defense prior to the adoption of this amendment.",
      "text_sha256": "91a44cef636a96b28c806d7e17de6c625abf6e6303a1d5c864b217da52a86c21",
      "publisher_sha256": "ae0846f198d634ff30253d8a1a33aa311cf4f17f41fd81f4586d6c3a590f80ac",
      "retrieved_at": "2026-11-17T19:33:57.131589+00:00",
      "language": "en",
      "currentness": "unresolved"
    },
    "aaf84ed5f67205bce7b87dbdf15b8c": {
      "citation": "Idaho Code § 5-217",
      "source_id": "US-ID:oral_contract_limitations:69cf8e101094",
      "authority_type": "statute",
      "text": "5-217. Action on oral contract. Within four (4) years: An action upon a contract, obligation or liability not founded upon an instrument of writing.",
      "text_sha256": "00ab63cee053c4f0308711168e2d0832f506e1fa1b32552143bf3fcc3d305516",
      "publisher_sha256": "e867f4505530fa9232738bae137becd2a4abce0ed37621a131aec87d0d43d206",
      "retrieved_at": "2026-11-17T19:33:57.110131+00:00",
      "language": "en",
      "currentness": "unresolved"
    },
    "493595a89f22b1e17003b1ea51411d": {
      "citation": "Idaho Code § 6-801",
      "source_id": "US-ID:fault:e42a54e830ed",
      "authority_type": "statute",
      "language": "en",
      "text": "Contributory negligence or comparative responsibility shall not bar recovery in an action by any person or his legal representative to recover damages for negligence, gross negligence or comparative responsibility resulting in death or in injury to person or property, if such negligence or comparative responsibility was not as great as the negligence, gross negligence or comparative responsibility of the person against whom recovery is sought, but any damages allowed shall be diminished in the proportion to the amount of negligence or comparative responsibility attributable to the person recovering. Nothing contained herein shall create any new legal theory, cause of action, or legal defense.",
      "text_sha256": "ec88d9e98002cdd060f9758578a1ca20b9f256973bfcf6aee5cc307cd2182b3a",
      "publisher_sha256": "7c2d94e86c2eb09ae62376af79dc66b220199fc55a12f79230ce58a457e6b92e",
      "retrieved_at": "2026-11-17T20:50:40.987973+00:00",
      "currentness": "unresolved"
    },
    "5b8917404e4cc9f1959332170ddb98": {
      "source_id": "US-ID:contract_formation:de1cc66ebe56",
      "authority_type": "statute",
      "citation": "Idaho Code § 28-2-204",
      "text": "A contract for sale of goods may be made in any manner sufficient to show agreement, including conduct by both parties which recognizes the existence of such a contract.",
      "text_sha256": "9c77be9f087223530e0d86a71047d66373e3a4889718dffe0aff6b1ded1679b9",
      "publisher_sha256": "51d82e0854f64ff8fa693e380e3cea23738ce38a2983765c283a9ae3cc51ecb4",
      "retrieved_at": "2026-11-18T15:14:39.421965+00:00",
      "currentness": "unresolved",
      "language": "en"
    },
    "cb117c84bb4dd91bed699d28b7ea22": {
      "source_id": "US-ID:deposit:7bd14db79305",
      "authority_type": "statute",
      "citation": "Idaho Code § 6-321",
      "text": "Amounts deposited by a tenant with a landlord for any purpose other than the payment of rent shall be deemed security deposits. Upon termination of a lease or rental agreement and surrender of the premises by the tenant all amounts held by the landlord as a security deposit shall be refunded to the tenant, except amounts necessary to cover the contingencies specified in the deposit arrangement. The landlord shall not retain any part of a security deposit to cover normal wear and tear. \"Normal wear and tear\" means that deterioration which occurs based upon the use for which the rental unit is intended and without negligence, carelessness, accident, or misuse or abuse of the premises or contents by the tenant or members of his household, or their invitees or guests. (2) Refunds shall be made within twenty-one (21) days if no time is fixed by agreement and, in any event, within thirty (30) days after surrender of the premises by the tenant. Any refunds in an amount less than the full amount deposited by the tenant shall be accompanied by a signed statement itemizing the amounts lawfully retained by the landlord, the purpose for the amounts retained, and a detailed list of expenditures made from the deposit. (3) If security deposits have been made as to a particular rental or lease property, and the property changes ownership during a tenancy, the new owner shall be liable for refund of the deposits. (4) A security deposit for a residential rental premises that is managed by a third-party manager of a landlord shall be maintained in a separate account at a federally insured financial institution. Such account shall be maintained separate from the third-party agent’s operating account. The requirements of this subsection shall not apply to a property owner, managers who have common members or principals of the property owner entity, a real estate licensee, or a nonprofit business organization as established under chapter 30, title 30, Idaho Code.",
      "text_sha256": "f805ee659a90aa4893a1f0ff7018c09c7c1f61495ef859ce9db779cfee45aacc",
      "publisher_sha256": "e00a978c1536f6f9a998fd77a00054bd16f94ed35b2ad4a9052073566c3bfc7e",
      "retrieved_at": "2026-11-19T19:20:36.456738+00:00",
      "currentness": "unresolved",
      "language": "en"
    }
  },
