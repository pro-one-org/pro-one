  "passages": {
    "3efd815bc50192716814db97c87fd1": {
      "source_id": "US-CO:contract_formation:083fd29499e7",
      "authority_type": "statute",
      "citation": "Colo. Rev. Stat. § 4-2-204",
      "text": "A contract for sale of goods may be made in any manner sufficient to show agreement, including conduct by both parties which recognizes the existence of such a contract.",
      "text_sha256": "9c77be9f087223530e0d86a71047d66373e3a4889718dffe0aff6b1ded1679b9",
      "publisher_sha256": "d4d69c6e2b319313e667492927a6740914f47de5a53c5722e9185c02a879102b",
      "retrieved_at": "2026-11-18T15:14:29.669421+00:00",
      "currentness": "historical",
      "language": "en",
      "edition": "2014 codification"
    },
    "f0ea553e8e677bd407b7ad943d4a5a": {
      "source_id": "US-CO:contract_damages:3278769f8196",
      "authority_type": "statute",
      "citation": "Colo. Rev. Stat. § 4-2-714",
      "text": "Where the buyer has accepted goods and given notification (subsection (3) of section 4-2-607), he may recover as damages for any nonconformity of tender the loss resulting in the ordinary course of events from the seller's breach as determined in any manner which is reasonable. (2) The measure of damages for breach of warranty is the difference at the time and place of acceptance between the value of the goods accepted and the value they would have had if they had been as warranted, unless special circumstances show proximate damages of a different amount.",
      "text_sha256": "e88394c062f7721abd4bce399aa30ce8acc64d696030d5f4b1768355e7a0cf38",
      "publisher_sha256": "d4d69c6e2b319313e667492927a6740914f47de5a53c5722e9185c02a879102b",
      "retrieved_at": "2026-11-18T15:14:29.669421+00:00",
      "currentness": "historical",
      "language": "en",
      "edition": "2014 codification"
    },
    "cb2e053b4071593362c5663cb8c4e5": {
      "source_id": "US-CO:negligence_elements:e5d1bd52a221",
      "authority_type": "opinion",
      "citation": "Raleigh v. Performance Plumbing, No. 04SC695 (Colo. Feb. 21, 2006)",
      "text": "Appropriately formulated and applied, tort principles adopted pursuant to the common law or legislative enactment are meant to deter and sanction conduct that results in victim injury and to remedy victim injury, in circumstances where the defendant owes a duty of care, defendant breaches the duty, that breach is the proximate cause of the plaintiff’s injuries, and damages result. See, e.g., Bayer v. Crested Butte Mountain Resorts, 960 P.2d 70, 80 (Colo. 1998).",
      "text_sha256": "ff561023233f4e731c0ba64c7571135e8d56839f349e740908489bc018912fd9",
      "publisher_sha256": "722b11c1b7f1ad8bf39fdb1cc613c950b28ffa028e5fce9e3dccab9d9b33a824",
      "retrieved_at": "2026-11-19T13:54:36.491435+00:00",
      "currentness": "historical",
      "language": "en",
      "edition": "Court opinion of 2006-02-21",
      "court": "Supreme Court of Colorado",
      "decision_date": "2006-02-21",
      "opinion_role": "majority",
      "procedural_posture": "Certiorari on negligent hiring and respondeat superior claims."
    },
    "addf4e2a966b9f009fb48577879d68": {
      "source_id": "US-CO:fault:3f3dffa88b1a",
      "authority_type": "opinion",
      "citation": "Westin Operator, LLC v. Groh, 2015 CO 25, n.9",
      "text": "The statute provides that a plaintiff’s contributory negligence does not bar recovery in a negligence action provided that “such negligence was not as great as the negligence of the person against whom recovery is sought.” § 13 -21-111(1). But it limits recovery in that “any damages allowed shall be diminished in proportion to the amount of negligence attributable to the person for whose injury, damage, or death recovery is made.” Id.",
      "text_sha256": "284dba0232b8ba2d62c34b17e69203b6266793041e6eb5f759faa6da6dcfa860",
      "publisher_sha256": "48327080891855d7b1107a5ee94622da15904257fb16dbe412a25367f230d991",
      "retrieved_at": "2026-11-19T18:57:49.194584+00:00",
      "currentness": "historical",
      "language": "en",
      "edition": "Court opinion of 2015-04-13",
      "court": "Supreme Court of Colorado",
      "decision_date": "2015-04-13",
      "opinion_role": "majority",
      "procedural_posture": "Certiorari review of summary judgment on negligence-related claims."
    }
  },
