  "passages": {
    "4974a9d050712beb6e5241b048806d": {
      "source_id": "US-TX:fault:e38dca8bf7e8",
      "citation": "Tex. Civ. Prac. & Rem. Code § 33.001",
      "authority_type": "statute",
      "text": "In an action to which this chapter applies, a claimant may not recover damages if his percentage of responsibility is greater than 50 percent.",
      "text_sha256": "4dbc6dd73e344326317680380731ce375d920e4c996cca295353be00076a63ad",
      "publisher_sha256": "884e293055350901b242356073665b86b875edc77ca8534369009acf90c7762f",
      "retrieved_at": "2026-11-17T21:03:50.594134+00:00",
      "currentness": "unresolved",
      "language": "en"
    },
    "965abeaf08d264b282ed0eec2d2d0a": {
      "source_id": "US-TX:contract_formation:19f18af64b2d",
      "authority_type": "statute",
      "citation": "Tex. Bus. & Com. Code § 2.204",
      "text": "A contract for sale of goods may be made in any manner sufficient to show agreement, including conduct by both parties which recognizes the existence of such a contract.",
      "text_sha256": "9c77be9f087223530e0d86a71047d66373e3a4889718dffe0aff6b1ded1679b9",
      "publisher_sha256": "a3afca2ca685f9c18edc631babf27140e321fe3460a73cffd97497a1dba2c1f3",
      "retrieved_at": "2026-11-18T15:14:39.879882+00:00",
      "currentness": "unresolved",
      "language": "en"
    },
    "a4f3861800c50a46bd369c16d756ee": {
      "source_id": "US-TX:contract_damages:7f1b8d4eea0f",
      "authority_type": "statute",
      "citation": "Tex. Bus. & Com. Code § 2.714",
      "text": "Where the buyer has accepted goods and given notification (Subsection (c) of Section 2.607) he may recover as damages for any non-conformity of tender the loss resulting in the ordinary course of events from the seller ’s breach as determined in any manner which is reasonable. (b)AAThe measure of damages for breach of warranty is the difference at the time and place of acceptance between the value of the goods accepted and the value they would have had if they had been as warranted, unless special circumstances show proximate damages of a different amount.",
      "text_sha256": "3a627f8da7d5b9d9ae5f13dbc89860c064c5eef01671a8e5684ce426328656fd",
      "publisher_sha256": "a3afca2ca685f9c18edc631babf27140e321fe3460a73cffd97497a1dba2c1f3",
      "retrieved_at": "2026-11-18T15:14:39.879882+00:00",
      "currentness": "unresolved",
      "language": "en"
    },
    "405569aabe8cdd47dda13a0d9c65de": {
      "source_id": "US-TX:commencement:e60e51166a6e",
      "authority_type": "court_rule",
      "citation": "Tex. R. Civ. P. 22",
      "text": "A civil suit in the district or county court shall be commenced by a petition filed in the office of the clerk.",
      "text_sha256": "7ba58e8ebecad80290cbd23acbfc9d7fd396a3e6f5114da67ff618b49004f90c",
      "publisher_sha256": "5428d16df065d6c5bd8b746576ee74b27ec67b36dd09ed03738a3c7ed370d3d3",
      "retrieved_at": "2026-11-18T20:45:47.983754+00:00",
      "currentness": "unresolved",
      "language": "en",
      "court": "Texas District and County Courts"
    },
    "7dd878c6acfa2a902158a392304053": {
      "source_id": "US-TX:service:c2d5cb3d22a9",
      "authority_type": "court_rule",
      "citation": "Tex. R. Civ. P. 103",
      "text": "Process including citation and other notices, writs, orders, and other papers issued by the court may be served anywhere by (1) any sheriff or constable or other person authorized by law, (2) any person authorized by law or by written order of the court who is not less than eighteen years of age, or (3) any person certified by the Judicial Branch Certification Commission. Service by registered or certified mail and citation by publication must, if requested, be made by the clerk of the court in which the case is pending. But no person who is a party to or interested in the outcome of a suit may serve any process in that suit, and, unless otherwise authorized by a written court order, only a sheriff or constable may serve a citation in an action of forcible entry and detainer, a writ that requires the actual taking of possession of a person, property or thing, or process requiring that an enforcement action be physically enforced by the person delivery the process. The order authorizing a person to serve pr ocess may be made without written motion and no fee may be imposed for issuance of such order.",
      "text_sha256": "6107f4a4ecd7f7e4dfe371c5ba3ce94792103207bed3280ced95884ac05b93f0",
      "publisher_sha256": "5428d16df065d6c5bd8b746576ee74b27ec67b36dd09ed03738a3c7ed370d3d3",
      "retrieved_at": "2026-11-18T20:45:47.983754+00:00",
      "currentness": "unresolved",
      "language": "en",
      "court": "Texas District and County Courts"
    },
    "fb09a78b05ed22242a6d1048b7d1f9": {
      "source_id": "US-TX:negligence_elements:10ce201fa206",
      "authority_type": "opinion",
      "citation": "Lakeside Village Homeowners Association, Inc. v. Belanger, No. 08-15-00214-CV (Tex. App. June 14, 2017)",
      "text": "The elements of negligence are the existence of a legal duty, breach of that duty, and damages proximately caused by the breach. Gharda USA, Inc. v. Control Solutions, Inc. , 464 S.W.3d 338, 352 (Tex. 2015); IHS Cedars Treatment Ctr. of DeSoto, Tex., Inc. v. Mason , 143 S.W.3d 794, 798 (Tex. 2004)(citation omitted). The components of proximate cause are cause in fact and foreseeability. Doe v. Boys Clubs of Greater Dallas, Inc. , 907 S.W.2d 472, 478 (Tex. 1995); Travis v. City of Mesquite , 830 S.W.2d 94, 98 (Tex. 1992). These elements cannot be established by mere conjecture, guess, or speculation. McClure v. Allied Stores of Tex., Inc., 608 S.W.2d 901, 903 (Tex. 1980); Farley v. MM Cattle Co. , 529 S.W.2d 751, 755 (Tex. 1975).",
      "text_sha256": "d6f6d065f1fa9c967e35d97f4dec85df6587b2d98aff6b4fca874e79cceb03d6",
      "publisher_sha256": "bb3afad1d274688672eadb49115eabef8e66234b79ee59b99479ca3e35a87f96",
      "retrieved_at": "2026-11-20T15:27:32.089519+00:00",
      "currentness": "historical",
      "language": "en",
      "edition": "Court opinion of 2017-06-14",
      "court": "Texas Eighth District Court of Appeals",
      "decision_date": "2017-06-14",
      "opinion_role": "majority",
      "procedural_posture": "Appeal from a judgment on townhome owners’ claims against an association and property management companies."
    },
    "895e6ad079ed7fe423d8a9a6fecae1": {
      "source_id": "US-TX:pi_limitations:a80c0ab9ca1d",
      "authority_type": "opinion",
      "citation": "Rodriguez v. Crowell, No. 08-07-00269-CV (Tex. App. Dec. 22, 2009)",
      "text": "A plaintiff must commence a suit for personal injuries within two years after the day the cause of action accrues. See Tex.Civ.Prac.&Rem.Code Ann. § 16.003(a)(Vernon Supp. 2009). Because the accrual date is not defined by statute, the courts are charged with the responsibility of articulating the rules governing accrual. See, e.g., S.V. v. R.V., 933 S.W.2d 1, 4 (Tex. 1996); see also Developments in the Law: Statutes of Limitations, 63 Harv. L.Rev. 1177, 1185 (1950). In most cases, a cause of action accrues when a wrongful act causes an injury, regardless of when the plaintiff learns of that injury or whether all resulting damages have yet to occur. See S.V., 933 S.W.2d at 4. However, in those rare cases when the nature of the injury incurred is inherently undiscoverable and the evidence of injury is objectively verifiable,” the Texas Supreme Court applies a judicially crafted exception to the general rule of accrual, known as the discovery rule.",
      "text_sha256": "6897807977d9fc0f156a7d7cf554e387b78409862fb8a7fe7f38d6e62e30874b",
      "publisher_sha256": "3bb849217b25f716a2c55d1bddb08a9e3f2225e3641497ab8f0954ab71f62ab5",
      "retrieved_at": "2026-11-20T15:43:52.036794+00:00",
      "currentness": "historical",
      "language": "en",
      "edition": "Court opinion of 2009-12-22",
      "court": "Texas Eighth District Court of Appeals",
      "decision_date": "2009-12-22",
      "opinion_role": "majority",
      "procedural_posture": "Review of summary judgment on limitations in a negligence and premises liability action involving latent occupational disease."
    }
  },
