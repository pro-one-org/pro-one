  "passages": {
    "18272de2d3b69b289dfcec178e4bf2": {
      "source_id": "US-AR:automated_contract_formation:d8f1d9eb7dc0",
      "authority_type": "statute",
      "citation": "Ark. Acts 2001, Act 905, § 14",
      "text": "In an automated transaction, the following rules apply: (1) A contract may be formed by the interaction of electronic agents of the parties, even if no individual was aware of or reviewed the electronic agents’ actions or the resulting terms and agreements. (2) A contract may be formed by the interaction of an electronic agent and an individual, acting on the individual’s own behalf or for another person, including by an interaction in which the individual performs actions that the individual is free to refuse to perform and which the individual knows or has reason to know will cause the electronic agent to complete the transaction or performance. (3) The terms of the contract are determined by the substantive law applicable to it.",
      "text_sha256": "04e3492db94d21f10eabb3e5f0b480425d0885c1b51f1a9fb519074706835579",
      "publisher_sha256": "3d87b91edc42d471c6efae71ab726e908a3df2b8c05bf2fc42c87b58fd348a24",
      "retrieved_at": "2026-11-18T20:43:21.496850+00:00",
      "currentness": "historical",
      "language": "en",
      "edition": "Approved March 19, 2001"
    },
    "5db561d6edffbb01fe6df51f6f5985": {
      "source_id": "US-AR:fault:02a012887ade",
      "authority_type": "statute",
      "citation": "1991 Ark. Acts 663, § 1 (Ark. Code Ann. § 16-64-122(a)–(b))",
      "text": "(a) In all actions for damages for personal injuries or wrongful death or injury to property in which recovery is predicated upon fault, liability shall be determined by comparing the fault chargeable to a claiming party with the fault chargeable to the party or parties from whom the claiming party seeks to recover damages. (b)(1) If the fault chargeable to a party claiming damages is of a lesser degree than the fault chargeable to the party or parties from whom the claiming party seeks to recover damages, then the claiming party is entitled to recover the amount of his damages after they have been diminished in proportion to the degree of his own fault. (2) If the fault chargeable to a party claiming damages is equal to or greater in degree than any fault chargeable to the party or parties from whom the claiming party seeks to recover damages, then the claiming party is not entitled to recover such damages.",
      "text_sha256": "036a77571bdb8d3a2c157a475c4f3a2d937b727ec3185cc15f75fa5cacfedc6a",
      "publisher_sha256": "6794209744e891e3fb7537e942b70de1c296c5da319a531da5c2b395af278f46",
      "retrieved_at": "2026-11-20T15:25:15.606937+00:00",
      "currentness": "historical",
      "language": "en",
      "edition": "1991 Arkansas Acts"
    },
    "b213f0c14241bdd350f8f2938d7d8b": {
      "source_id": "US-AR:fault:8d259b378465",
      "authority_type": "statute",
      "citation": "2023 Ark. Acts 354, § 2 (Ark. Code Ann. § 16-118-109(g))",
      "text": "(g) In a civil action brought under this section: (1) Fault of a victim of human trafficking shall not be apportioned against the victim of human trafficking; and (2) The comparative fault provisions under § 16-64-122 do not apply.",
      "text_sha256": "c6e83faf35729d31cf3c1deccdaf896225f3b93e66a8d5d7447f77e4e32ef209",
      "publisher_sha256": "e4d506b2e9f50ee6ce25d3730fedf87831bb8d31a4d6a6abeb8ab89bc18a15bd",
      "retrieved_at": "2026-11-20T15:25:15.746813+00:00",
      "currentness": "historical",
      "language": "en",
      "edition": "2023 Arkansas Acts"
    },
    "13a33fbb3d9d0d49784dab1562e7ec": {
      "source_id": "US-AR:pi_limitations:ed4cbd23e1c1",
      "authority_type": "opinion",
      "citation": "Shelter Mutual Insurance Co. v. Nash, 357 Ark. 581 (2004)",
      "text": "An action for personal injury, however, must be brought within three years after the cause of action accrues. Ark. Code Ann. § 16-56-105 (Supp. 2001).",
      "text_sha256": "891a47561dbfe6fcce8699c229727f70cc9d1e4cac35625a87ac1f30f288b281",
      "publisher_sha256": "d986fcbd85a0fc2b2030bb6b4d7c66c6bcbfd9329d000e5b4662c8a54ce7fc76",
      "retrieved_at": "2026-11-20T15:49:45.764807+00:00",
      "currentness": "historical",
      "language": "en",
      "edition": "Court-reported opinion of 2004-06-03",
      "court": "Supreme Court of Arkansas",
      "decision_date": "2004-06-03",
      "opinion_role": "majority",
      "procedural_posture": "Review of a certified question arising in an underinsured motorist contract dispute. The court distinguished personal-injury and written-contract statutes."
    },
    "4b2cb3ccfd87171a80e2b5399f9779": {
      "source_id": "US-AR:contract_formation:9ef844c5754c",
      "authority_type": "opinion",
      "citation": "The Money Place, LLC v. Barnes, 349 Ark. 411 (2002)",
      "text": "The essential elements of a contract are (1) competent parties, (2) subject matter, (3) legal consideration, (4) mutual agreement, and (5) mutual obligations.",
      "text_sha256": "755ae746c45a3a409db9e622ffabe449b422437447742fb077ebdcf6b489139a",
      "publisher_sha256": "400e727b671ca1a90880fd2544f84610d03df71971e1e91591b8763fc24610cb",
      "retrieved_at": "2026-11-20T15:49:46.354046+00:00",
      "currentness": "historical",
      "language": "en",
      "edition": "Court-reported opinion of 2002-06-20",
      "court": "Supreme Court of Arkansas",
      "decision_date": "2002-06-20",
      "opinion_role": "majority",
      "procedural_posture": "Appeal from denial of a motion to compel arbitration. The court discussed ordinary formation elements in reviewing the asserted agreement."
    }
  },
  "fault_allocation": {
    "regime": "modified_comparative_50",
    "source_id": "US-AR:fault:02a012887ade",
    "passage_selector": "5db561d6edffbb01fe6df51f6f5985",
    "currentness": "historical",
    "qualification": "This enacted version compared the claimant’s fault with the party or parties from whom the claimant sought recovery. The later 2023 enactment added a separate rule for the civil action under Ark. Code Ann. § 16-118-109."
  }
}
