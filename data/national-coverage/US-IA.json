  "passages": {
    "6bfc73a64a49ce7a625745edd8e44c": {
      "citation": "Iowa Code § 668.3(1)(a)",
      "source_id": "US-IA:fault:f3b39ea29516",
      "authority_type": "statute",
      "language": "en",
      "text": "1. a. Contributory fault shall not bar recovery in an action by a claimant to recover damages for fault resulting in death or in injury to person or property unless the claimant bears a greater percentage of fault than the combined percentage of fault attributed to the defendants, third-party defendants and persons who have been released pursuant to section 668.7 , but any damages allowed shall be diminished in proportion to the amount of fault attributable to the claimant.",
      "text_sha256": "a8b55e85aea72fb077a9acfafeeaf529e9cffea29a3c24a9e00a31e652fbe85a",
      "publisher_sha256": "80828e7f7cd84a4ebc8f4716490387326e8c17d01eb784a4cf9238d5c2cc98a4",
      "retrieved_at": "2026-11-17T20:50:33.379562+00:00",
      "currentness": "unresolved"
    },
    "419a82cf73423ee71512bb94d6df57": {
      "source_id": "US-IA:contract_formation:50f4964511a8",
      "authority_type": "statute",
      "citation": "Iowa Code § 554.2204",
      "text": "A contract for sale of goods may be made in any manner sufficient to show agreement, including conduct by both parties which recognizes the existence of such a contract.",
      "text_sha256": "9c77be9f087223530e0d86a71047d66373e3a4889718dffe0aff6b1ded1679b9",
      "publisher_sha256": "fb0e626421a62ffcc6a4f51f7965c34bc3d0535fbb09f5643dc3273cb5bc78b9",
      "retrieved_at": "2026-11-18T15:14:37.322821+00:00",
      "currentness": "historical",
      "language": "en",
      "edition": "2025 codification"
    },
    "d30e3835dda9f7f4ddadaa1fb69fab": {
      "source_id": "US-IA:contract_damages:a03ce538f3e4",
      "authority_type": "statute",
      "citation": "Iowa Code § 554.2714",
      "text": "Where the buyer has accepted goods and given notification (section 554.2607, subsection 3) the buyer may recover as damages for any nonconformity of tender the loss resulting in the ordinary course of events from the seller’s breach as determined in any manner which is reasonable. 2. The measure of damages for breach of warranty is the difference at the time and place of acceptance between the value of the goods accepted and the value they would have had if they had been as warranted, unless special circumstances show proximate damages of a different amount.",
      "text_sha256": "5726f230507a75cc688943ddc4a8e450eb22d7c5e7039987b57f7fbf6e7594bd",
      "publisher_sha256": "fb0e626421a62ffcc6a4f51f7965c34bc3d0535fbb09f5643dc3273cb5bc78b9",
      "retrieved_at": "2026-11-18T15:14:37.322821+00:00",
      "currentness": "historical",
      "language": "en",
      "edition": "2025 codification"
    },
    "4a2d6a77adc8e22fa271ac6cec6e32": {
      "source_id": "US-IA:wageLaw:9d5d4f8a6ffc",
      "authority_type": "statute",
      "citation": "Iowa Code § 91A.3(1)",
      "text": "An employer shall pay all wages due its employees, less any lawful deductions specified in section 91A .5 , at least in monthly , semimonthly , or biweekly installments on regular paydays which are at consistent intervals from each other and which are designated in advance by the employer . However , if any of these wages due its employees are determined on a commission basis, the employer may , upon agreement with the employee, pay only a credit against such wages. If such credit is paid, the employer shall, at regular intervals, pay any difference between a credit paid against wages determined on a commission basis and such wages actually earned on a commission basis. These regular intervals shall not be separated by more than twelve months. A regular payday shall not be more than twelve days, excluding Sundays and legal holidays, after the end of the period in which the wages were earned. An employer and employee may , upon written agreement which shall be maintained as a record, vary the provisions of this subsection .",
      "text_sha256": "97c6ed82ef6ea7ada129bc9bf091a3a0cc6082bd35e886ac1130c1d38f6d9786",
      "publisher_sha256": "b1b1d823adb918ce08e0363490edf26a58a1b941e89baf3fbc570434090a79ef",
      "retrieved_at": "2026-11-18T20:21:42.650683+00:00",
      "currentness": "historical",
      "language": "en",
      "edition": "Iowa Code 2025"
    },
    "c7db18de9d7f3d55e9d92632c544b4": {
      "source_id": "US-IA:deposit:c90de55d38ee",
      "authority_type": "statute",
      "citation": "Iowa Code § 562A.12(1)",
      "text": "A landlord shall not demand or receive as a security deposit an amount or value in excess of two months’ rent.",
