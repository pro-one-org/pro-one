      "court": "Hawaii Circuit Court"
    },
    "de8e4d5fe7befe60449759fa31ef32": {
      "source_id": "US-HI:pi_limitations:2d79a64d0936",
      "authority_type": "statute",
      "citation": "Haw. Rev. Stat. § 657-7",
      "text": "Actions for the recovery of compensation for damage or injury to persons or property shall be instituted within two years after the cause of action accrued, and not after, except as provided in section 657-13.",
      "text_sha256": "4fec815e4ca698689d765137f5b59c6d78c0db1111770fc103716da2b9f9c38b",
