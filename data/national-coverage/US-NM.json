  "passages": {
    "e9e7af976c7b958ee2e8fd908b9230": {
      "source_id": "US-NM:contract_formation:17ce32eff880",
      "authority_type": "opinion",
      "citation": "White Sands Construction, Inc. v. City of Las Cruces, No. A-1-CA-39429, ¶ 9 (N.M. Ct. App. Apr. 27, 2023)",
      "text": "“The essential attributes of a contract include an offer, an acceptance, consideration, and mutual assent.”",
      "text_sha256": "bc6e4063e27094d368e236a60d7d7c596606c8058db45b4b4246cfee8923be05",
      "publisher_sha256": "dd819a2a7d3af23d902c63ea2b72eeb60535815ecf23fcbbe0da3925d2557e12",
      "retrieved_at": "2026-11-18T20:40:12.862780+00:00",
      "currentness": "historical",
      "language": "en",
      "edition": "Court opinion of 2023-04-27",
      "court": "Court of Appeals of New Mexico",
      "decision_date": "2023-04-27",
      "opinion_role": "unanimous",
      "procedural_posture": "Appeal from district court. Interest award affirmed in part and remanded for recalculation."
    },
    "1e46ee2566a6fb0dde4c053ca76546": {
      "source_id": "US-NM:negligence_elements:643606fd9c49",
      "authority_type": "opinion",
      "citation": "Lujan v. New Mexico Department of Transportation, No. 31,883 (N.M. Ct. App. Aug. 4, 2014)",
      "text": "“It is axiomatic that a negligence action requires that there be a duty owed from the defendant to the plaintiff; that based on a standard of reasonable care under the circumstances, the defendant breached that duty; and that the breach was a cause in fact and proximate cause of the plaintiff’s damages.” Romero v. Giant Stop-N-Go of N.M., Inc., 2009-NMCA-059, ¶ 5, 146 N.M. 520, 212 P.3d 408.",
      "text_sha256": "c427f25dab68721a96b56efbdc4871b08bacb00fdabe4c9031cc27181e4b4333",
      "publisher_sha256": "0134230f1e9ec453844d8796c1b2191f419bc9f1ab1606d1ddf42a3c8a49f7af",
      "retrieved_at": "2026-11-19T13:54:45.048993+00:00",
      "currentness": "historical",
      "language": "en",
      "edition": "Court opinion of 2014-08-04",
      "court": "Court of Appeals of New Mexico",
      "decision_date": "2014-08-04",
      "opinion_role": "majority",
      "procedural_posture": "Reversed summary judgment for the state transportation department."
    },
    "30a258e2647a06e5e1fb843cb95c3b": {
      "source_id": "US-NM:pi_limitations:e9e4833186bd",
      "authority_type": "opinion",
      "citation": "Gomez v. Chavarria, Nos. 28,072 and 28,073, ¶ 7 (N.M. Ct. App. Jan. 12, 2009)",
      "text": "The three-year limitations period in Section 37-1-8 begins to run against both adults and minors when the cause of action accrues. Slade v. Slade, 81 N.M. 462, 466, 468 P.2d 627, 631 (1970). It is quite clear from a plain reading of Section 37-1-10 that, when the three-year limitations period in Section 37-1-8 runs its full course during minority status, Section 37-1-10 gives the minor a year from his or her eighteenth birthday within which to sue.",
      "text_sha256": "0437bca7397bd966b5cbcc20423f245c27104719f92c89ee316de6307aecd58f",
      "publisher_sha256": "70a18b24e7ad1bc49b5870b000dd579ad4b2d613a09b200f8304314b81a93ec6",
      "retrieved_at": "2026-11-20T15:40:20.079501+00:00",
      "currentness": "historical",
      "language": "en",
      "edition": "Court opinion of 2009-01-12",
      "court": "New Mexico Court of Appeals",
      "decision_date": "2009-01-12",
      "opinion_role": "majority",
      "procedural_posture": "Appeal from dismissals of personal-injury actions arising out of two vehicle collisions. The court addressed the interplay of the general statute and the provision for minors."
    },
    "512e897a4c49c27de12aa938f7764e": {
      "source_id": "US-NM:consumerLaw:75a3dd06e59d",
      "authority_type": "opinion",
      "citation": "Salas v. Guadalupe Credit Union, 2025-NMSC-006, ¶ 44",
      "text": "The UPA further declares, “Unfair or deceptive trade practices and unconscionable trade practices in the conduct of any trade or commerce are unlawful.” Section 57-12-3.",
      "text_sha256": "a1884a92ba6fbf7c2a48bc66be5aa58ad5463961843929bb28abf02e8fa05b13",
      "publisher_sha256": "e7e4e039ae496673b788be8df9ef788e22b886649667a0ce613b329dd5acb75b",
      "retrieved_at": "2026-11-20T16:22:38.477811+00:00",
      "currentness": "historical",
      "language": "en",
      "edition": "Court opinion of 2024-10-28",
      "court": "Supreme Court of New Mexico",
      "decision_date": "2024-10-28",
      "opinion_role": "majority",
      "procedural_posture": "Certiorari review of dismissal of a challenge to representation by credit-union staff in a magistrate-court action. The court directed reinstatement of the complaint."
    },
    "714aad3de1f102901882270c10f46e": {
      "source_id": "US-NM:fault:29fff0fcb402",
      "authority_type": "opinion",
      "citation": "Scott v. Rizzo, 1981-NMSC-021, ¶ 30",
      "text": "Considering all of these reasons, we conclude that adoption of a rule of pure comparative negligence more nearly synthesizes the long-standing legal thought on the subject than any other form. We therefore hold that a pure comparative negligence standard shall supersede prior law in New Mexico, and that a plaintiff suing in negligence shall no longer be totally barred from recovery because of his contributory negligence.",
      "text_sha256": "55b8f856fd417d4a6edbd5ddb6157ab02b28c76ed1e887d47fb532cbf14e2e38",
      "publisher_sha256": "847628e4a7b71079a3ebca4970dd15f55ac68e4a3aea81da141d407536a5a9a9",
      "retrieved_at": "2026-11-20T16:23:37.905010+00:00",
      "currentness": "historical",
      "language": "en",
      "edition": "Court opinion of 1981-02-12",
      "court": "Supreme Court of New Mexico",
      "decision_date": "1981-02-12",
      "opinion_role": "majority",
      "procedural_posture": "Certiorari in consolidated negligence proceedings concerning the effect of plaintiff fault. The court remanded for application of comparative negligence."
    },
    "1056f722cf5836b79ee34d1cf47025": {
      "source_id": "US-NM:employment_contract_formation:1369ea32d3dd",
      "authority_type": "opinion",
      "citation": "Hartbarger v. Frank Paxton Co., 1993-NMSC-029, ¶ 6",
      "text": "Implied employment contract restricting employer's power to discharge employee is an implied-in-fact contract. The question whether an employment relationship has been modified is a question of fact. Lukoski, 106 N.M. at 666, 748 P.2d at 509. A promise, or offer, that supports an implied contract might be found in written representations such as an employee handbook, in oral representations, in the conduct of the parties, or in a combination of representations and conduct.",
      "text_sha256": "61a5bb2b606c4641189e9fb23e5205ea9ca3adf5c4c518a039328c5a9f7d6329",
      "publisher_sha256": "92605b8bfadc32a956fe144aea5bc9b3a6a0cb93248af9270983ec7bc781beac",
      "retrieved_at": "2026-11-20T16:23:37.914951+00:00",
      "currentness": "historical",
      "language": "en",
      "edition": "Court opinion of 1993-06-14",
      "court": "Supreme Court of New Mexico",
      "decision_date": "1993-06-14",
      "opinion_role": "majority",
      "procedural_posture": "Appeal from a jury verdict for a discharged employee. The court reversed and ordered judgment for the employer. The retained rule is limited to implied-in-fact employment terms."
    }
  },
  "fault_allocation": {
