  "passages": {
    "bafe9f02e02a7a481a2649f0453e13": {
      "citation": "Fla. Stat. § 768.81(6)",
      "source_id": "US-FL:fault:826a11fa4bd3",
      "authority_type": "statute",
      "language": "en",
      "text": "(6) GREATER PERCENTAGE OF FAULT.—In a negligence action to which this section applies, any party found to be greater than 50 percent at fault for his or her own harm may not recover any damages. This subsection does not apply to an action for damages for personal injury or wrongful death arising out of medical negligence pursuant to chapter 766.",
      "text_sha256": "ae7d9f4e5b5d6a89ae93c0c7dc137b30f059d73c3635650713ea3ceb852d4492",
      "publisher_sha256": "af7c149bf511152e462914eac4d4b0f4545ff60a724e5dc1bb2be08b235f18b5",
      "retrieved_at": "2026-11-17T20:50:32.798686+00:00",
      "currentness": "unresolved"
    }
  },
