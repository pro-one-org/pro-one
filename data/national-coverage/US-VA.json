    "ee9b27743a538dea7c41d02504c968": {
      "source_id": "US-VA:small_claims:03d3fbf77f95",
      "authority_type": "statute",
      "citation": "Va. Code § 16.1-122.2",
      "text": "Notwithstanding any provision of law to the contrary, the small claims court shall have jurisdiction, concurrent with that of the general district court, over the civil action specified in § 16.1-77 (1) when the amount claimed does not exceed $5,000, exclusive of interest.",
      "text_sha256": "685e75dd9e05a057938cb4b9d7337ef798c409d4cae2678015f0b1a5a307cfe8",
