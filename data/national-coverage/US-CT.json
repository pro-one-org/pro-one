  "passages": {
    "8786e92c49f51e503c389e8550bdde": {
      "citation": "Conn. Gen. Stat. § 52-572h(b)",
      "source_id": "US-CT:fault:33b05f66ddff",
      "authority_type": "statute",
      "language": "en",
      "text": "(b) In causes of action based on negligence, contributory negligence shall not bar recovery in an action by any person or the person's legal representative to recover damages resulting from personal injury, wrongful death or damage to property if the negligence was not greater than the combined negligence of the person or persons against whom recovery is sought including settled or released persons under subsection (n) of this section. The economic or noneconomic damages allowed shall be diminished in the proportion of the percentage of negligence attributable to the person recovering which percentage shall be determined pursuant to subsection (f) of this section.",
      "text_sha256": "4a93fc8317e27cefe46464c14a5ffded23e0dfd4d2615a66972c5d3a695e2105",
      "publisher_sha256": "13c746baac0113d9968df4063b8fd30d7883ef86e0d109ae276acc77b439e7e5",
      "retrieved_at": "2026-11-17T20:50:32.783493+00:00",
      "currentness": "historical",
      "edition": "2025 publication"
    },
    "619dbd2c06c8fe77c7a5464d9e7420": {
      "source_id": "US-CT:consumerLaw:b833f7dbb849",
      "authority_type": "statute",
      "citation": "Conn. Gen. Stat. § 42-110b(a)",
      "text": "(a) No person shall engage in unfair methods of competition and unfair or deceptive acts or practices in the conduct of any trade or commerce.",
      "text_sha256": "3927ad5a3cde297117ea097f498687c657a949d6d41a9bb935e2443fba4440dc",
      "publisher_sha256": "670245dbbeca6b25d41fb16906546308e7c5a214c6a67ccde76c28deca00c796",
      "retrieved_at": "2026-11-17T21:03:51.350640+00:00",
      "currentness": "unresolved",
      "language": "en"
    },
    "8ddb1518d2bb0500d7123fe875c324": {
      "source_id": "US-CT:contract_formation:3dffa641c276",
      "authority_type": "statute",
      "citation": "Conn. Gen. Stat. § 42a-2-204",
      "text": "A contract for sale of goods may be made in any manner sufficient to show agreement, including conduct by both parties which recognizes the existence of such a contract.",
      "text_sha256": "9c77be9f087223530e0d86a71047d66373e3a4889718dffe0aff6b1ded1679b9",
      "publisher_sha256": "eccbb0d711a42bfa6b23924391a796a784b42f2818a626fed4514b9900e3dab8",
      "retrieved_at": "2026-11-18T15:14:26.543556+00:00",
      "currentness": "historical",
      "language": "en",
      "edition": "2025 codification"
    },
    "a0a5523980771428391f7cef7b496e": {
      "source_id": "US-CT:contract_damages:353707f163a7",
      "authority_type": "statute",
      "citation": "Conn. Gen. Stat. § 42a-2-714",
      "text": "Where the buyer has accepted goods and given notification as provided in subsection (3) of section 42a-2-607 he may recover as damages for any nonconformity of tender the loss resulting in the ordinary course of events from the seller's breach as determined in any manner which is reasonable. (2) The measure of damages for breach of warranty is the difference at the time and place of acceptance between the value of the goods accepted and the value they would have had if they had been as warranted, unless special circumstances show proximate damages of a different amount.",
      "text_sha256": "0b5ddc7592e3695e2ffda38a4e9ddf888cbc524fbeadf31ab7d1e8a043505a95",
      "publisher_sha256": "eccbb0d711a42bfa6b23924391a796a784b42f2818a626fed4514b9900e3dab8",
      "retrieved_at": "2026-11-18T15:14:26.543556+00:00",
      "currentness": "historical",
      "language": "en",
      "edition": "2025 codification"
    },
    "532fb893c4b1aa2eae00568df501c3": {
      "source_id": "US-CT:wageLaw:68977cad0702",
      "authority_type": "statute",
      "citation": "Conn. Gen. Stat. § 31-71c",
      "text": "(a) Whenever an employee voluntarily terminates his employment, the employer shall pay the employee's wages in full not later than the next regular pay day, as designated under section 31-71b, either through the regular payment channels or by mail. (b) Whenever an employer discharges an employee, the employer shall pay the employee's wages in full not later than the business day next succeeding the date of such discharge. (c) When work of any employee is suspended as a result of a labor dispute, or when an employee for any reason is laid off, the employer shall pay in full to such employee the wages earned by him not later than the next regular pay day, as designated under section 31-71b.",
      "text_sha256": "35c13a3c523d2107b596e5f0228e5d3aaa7a4af555d1ed3de3462ff1f6deb016",
      "publisher_sha256": "ed6642bd9e7b553dea4399e6c18b777f0b529906d8378556eb220e6cd8471692",
      "retrieved_at": "2026-11-19T14:10:56.026660+00:00",
      "currentness": "unresolved",
      "language": "en"
    }
  },
