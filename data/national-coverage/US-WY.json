  "passages": {
    "4f0279820e3e29ac76bd9a48816d9f": {
      "citation": "Wyo. Stat. § 1-1-109(b)",
      "source_id": "US-WY:fault:7dd5d5aac4a7",
      "authority_type": "statute",
      "language": "en",
      "text": "(b) Contributory fault shall not bar a recovery in an action by any claimant or the claimant's legal representative to recover damages for wrongful death or injury to person or property, if the contributory fault of the claimant is not more than fifty percent (50%) of the total fault of all actors. Any damages allowed shall be diminished in proportion to the amount of fault attributed to the claimant.",
      "text_sha256": "29ebd196cd035040e47e47973149ece0efdc7ec2e1460def49785c7025cbf237",
      "publisher_sha256": "44b895e013260515acaedb4ba103fb746bf53e73c973d533ea66a98067433a9f",
      "retrieved_at": "2026-11-17T20:50:39.607321+00:00",
      "currentness": "unresolved"
    }
  },
