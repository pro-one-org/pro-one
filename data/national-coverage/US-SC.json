  "passages": {
    "932e7f8a958ff21f1e47b0270a07b5": {
      "citation": "S.C. Code § 39-5-20",
      "source_id": "US-SC:consumerLaw:0b6b786a8fb2",
      "authority_type": "statute",
      "text": "(a) Unfair methods of competition and unfair or deceptive acts or practices in the conduct of any trade or commerce are hereby declared unlawful. (b) It is the intent of the legislature that in construing paragraph (a) of this section the courts will be guided by the interpretations given by the Federal Trade Commission and the Federal Courts to Section 5(a) (1) of the Federal Trade Commission Act (15 U.S.C. 45(a)(1)), as from time to time amended.",
      "text_sha256": "9540d95bbd624bc5437265c6c7f49e36408cc40098cdc73589728a7677da736a",
      "publisher_sha256": "5d59d752058185c071e8f7b90e1873c98cea59f9419928bf9e7421850183bf7a",
      "retrieved_at": "2026-11-17T19:43:06.726355+00:00",
      "language": "en",
      "currentness": "historical",
      "edition": "2018 archived Code of Laws"
    },
    "91f9eaf41e148e122e90217aa3a0c5": {
      "citation": "S.C. Code § 39-5-20",
      "source_id": "US-SC:consumerLaw:4cb74b476065",
      "authority_type": "statute",
      "text": "(a) Unfair methods of competition and unfair or deceptive acts or practices in the conduct of any trade or commerce are hereby declared unlawful. (b) It is the intent of the legislature that in construing paragraph (a) of this section the courts will be guided by the interpretations given by the Federal Trade Commission and the Federal Courts to Section 5(a) (1) of the Federal Trade Commission Act (15 U.S.C. 45(a)(1)), as from time to time amended.",
      "text_sha256": "9540d95bbd624bc5437265c6c7f49e36408cc40098cdc73589728a7677da736a",
      "publisher_sha256": "8a5faf02c17cdb9456e004774cb91811e77f3b6c94a42cda96d20f8973900c00",
      "retrieved_at": "2026-11-18T15:06:27.866203+00:00",
      "language": "en",
      "currentness": "unresolved"
    },
    "3e9b344b00b9d44bca71ca65dbd1ca": {
      "source_id": "US-SC:contract_formation:82e2f2a00fcb",
      "authority_type": "statute",
      "citation": "S.C. Code § 36-2-204",
      "text": "A contract for sale of goods may be made in any manner sufficient to show agreement, including conduct by both parties which recognizes the existence of such a contract.",
      "text_sha256": "9c77be9f087223530e0d86a71047d66373e3a4889718dffe0aff6b1ded1679b9",
      "publisher_sha256": "a9dded040ef7b53901e1f121acc42e2585c097dc6d08a5596975ac923bbaf020",
      "retrieved_at": "2026-11-18T15:14:32.481170+00:00",
      "currentness": "unresolved",
      "language": "en"
    },
    "a44315e776488c0db0978bd2744433": {
      "source_id": "US-SC:contract_damages:cfe6a8599e5a",
      "authority_type": "statute",
      "citation": "S.C. Code § 36-2-714",
      "text": "Where the buyer has accepted goods and given notification (subsection (3) of SECTION 36-2-607) he may recover as damages for any nonconformity of tender the loss resulting in the ordinary course of events from the seller's breach as determined in any manner which is reasonable. (2) The measure of damages for breach of warranty is the difference at the time and place of acceptance between the value of the goods accepted and the value they would have had if they had been as warranted, unless special circumstances show proximate damages of a different amount.",
      "text_sha256": "a85629d289bd11974e14c30a97ab6d6aa767e6ee726bd8998e1e22744fe891de",
      "publisher_sha256": "a9dded040ef7b53901e1f121acc42e2585c097dc6d08a5596975ac923bbaf020",
      "retrieved_at": "2026-11-18T15:14:32.481170+00:00",
      "currentness": "unresolved",
      "language": "en"
    },
    "a5a443ef8351bd62a35c3bb7faf9a0": {
      "source_id": "US-SC:commencement:1ed1bff7bcf2",
      "authority_type": "court_rule",
      "citation": "S.C. R. Civ. P. 3(a)",
      "text": "(a) Commencement of civil action. A civil action is commenced when the summons and complaint are filed with the clerk of court if: (1) the summons and complaint are served within the statute of limitations in any manner prescribed by law; or (2) if not served within the statute of limitations, actual service must be accomplished not later than one hundred twenty days after filing.",
      "text_sha256": "56fc851dd6a72ff944c01e7962c8ab048473640ee0e3a57a6eb9240e6c1f6705",
      "publisher_sha256": "ced9775a0b20feb4f88d5c935b64024e81924ccaca61428d6d050cf2380b1c24",
      "retrieved_at": "2026-11-18T20:45:46.201127+00:00",
      "currentness": "unresolved",
      "language": "en",
      "court": "South Carolina Circuit Court"
    }
  }
