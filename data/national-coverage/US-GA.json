  "passages": {
    "e28d84cee4570b6d057333050cc7ad": {
      "citation": "O.C.G.A. § 51-12-33(g)",
      "source_id": "US-GA:fault:7adbad27dfab",
      "authority_type": "statute",
      "language": "en",
      "text": "(g) Notwithstanding the provisions of this Code section or any other provisions of law which might be construed to the contrary , the plaintiff shall not be entitled to receive any damages if the plaintiff is 50 percent or more responsible for the injury or damages claimed.",
      "text_sha256": "c3b5d71b3b020305e8923679a5062fc7e9ea0ec5b4ed005aeba295e969972107",
      "publisher_sha256": "9104a04c683d8ee006f80ffc59a6f2d127734ee2939e86489bc42feda00a98c0",
      "retrieved_at": "2026-11-17T20:50:34.067833+00:00",
      "currentness": "historical",
      "edition": "2025 Supplement"
    },
    "344ab9322beddc6378993233d86a75": {
      "source_id": "US-GA:contract_formation:b8903af49e39",
      "authority_type": "statute",
      "citation": "O.C.G.A. § 11-2-204",
      "text": "A contract for sale of goods may be made in any manner sufficient to show agreement, including conduct by both parties which recognizes the existence of such a contract.",
      "text_sha256": "9c77be9f087223530e0d86a71047d66373e3a4889718dffe0aff6b1ded1679b9",
      "publisher_sha256": "ad397fccbf21994357afda463fca395efe9ecdb8c1a50948888b771f8b4c5695",
      "retrieved_at": "2026-11-18T15:14:31.286212+00:00",
      "currentness": "historical",
      "language": "en",
      "edition": "2022 publication"
    },
    "4ac1cbf615bc910ba53cc25c342db0": {
      "source_id": "US-GA:pi_limitations:b29eac731acf",
      "authority_type": "opinion",
      "citation": "Omstead v. BPG Inspection, LLC, 319 Ga. 512 (2024)",
      "text": "As relevant here, Omstead asserts a claim for wrongful death, which “does not accrue until the death occurs[.]” Williams v. Ga. Dept. of Human Resources, 272 Ga. 624, 626 (532 SE2d 401) (2000). See OCGA § 9-3-33 (“[A]ctions for injuries to the person shall be brought within two years after the right of action accrues[.]”).",
      "text_sha256": "86dac1021d8633b02bef2444f3d9fade6764409244153b86c6e28e5bb832e2f1",
      "publisher_sha256": "d616fc634107bc6cbbe1ee37ec1c90d751db338cd597d40171efe624071386bc",
      "retrieved_at": "2026-11-20T15:45:44.675321+00:00",
      "currentness": "historical",
      "language": "en",
      "edition": "Court opinion of 2024-06-11",
      "court": "Supreme Court of Georgia",
      "decision_date": "2024-06-11",
      "opinion_role": "majority",
      "procedural_posture": "Review of a wrongful-death claim involving a contractually shortened limitation. The court quoted the ordinary statutory period and enforced the separate contractual term in this case."
    },
    "d811a4a1341d0b1139990145482032": {
      "source_id": "US-GA:consumerLaw:70deb7cadee9",
      "authority_type": "statute",
      "citation": "O.C.G.A. § 10-1-393(a) (2025 Supp.)",
      "text": "(a) Unfair or deceptive acts or practices in the conduct of consumer transactions and consumer acts or practices in trade or commerce are declared unlawful.",
      "text_sha256": "ce2fd9a95b5ef0382caab14c80c9a63b9db2d99a65251bd25cff4e6e94aa9437",
      "publisher_sha256": "f1fc4f45d8c665b3180be42133721febeabd59a03153409291b8f6cc2a2f82c9",
      "retrieved_at": "2026-11-20T16:29:35.191438+00:00",
      "currentness": "historical",
      "language": "en",
      "edition": "2025 Georgia Code supplement incorporating the 2025 regular session"
    }
