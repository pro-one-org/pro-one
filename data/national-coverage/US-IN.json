  "passages": {
    "bb286762ae5d998dd422a4af14f52c": {
      "source_id": "US-IN:contract_formation:242e3aa726b1",
      "authority_type": "opinion",
      "citation": "Teachers Credit Union v. Cripe, No. 24A-PL-698, ¶ 17 (Ind. Ct. App. Dec. 13, 2024)",
      "text": "“[A]n arbitration agreement, as with a typical contract, requires ‘offer, acceptance of the offer and consideration.’” Land 1, 218 N.E.3d at 1287 (quoting Reitenour v. M/I Homes of Ind., L.P., 176 N.E.3d 505, 510-11 (Ind. Ct. App. 2021)).",
      "text_sha256": "6b931e0a88641e1bbe8b1f6009d28d209aa204159562d3f2e92f4c56cd773cc4",
      "publisher_sha256": "0649b5c227b691bd165208034482ea08d649bf44186a5e594aa4caf474430789",
      "retrieved_at": "2026-11-18T20:31:28.092951+00:00",
      "currentness": "historical",
      "language": "en",
      "edition": "Court opinion of 2024-12-13",
      "court": "Court of Appeals of Indiana",
      "decision_date": "2024-12-13",
      "opinion_role": "unanimous",
      "procedural_posture": "Appeal from denial of a motion to compel arbitration and dismiss the complaint; affirmed."
    },
    "036adde652717d353b97780f2f001f": {
      "source_id": "US-IN:commencement:23ba97cb5daa",
      "authority_type": "court_rule",
      "citation": "Ind. Trial Rule 3",
      "text": "A civil action is commenced by filing with the court a complaint or such equivalent pleading or document as may be specified by statute, by payment of the prescribed filing fee or filing an order waiving the filing fee, and, where service of process is required, by furnishing to the clerk as many copies of the complaint and summons as are necessary.",
      "text_sha256": "79536e84dc8e12278fbf187b8f64c14fdb0464c564c2c992d154cff11911d6eb",
      "publisher_sha256": "47fa6ac872713f4367b7badc078ed406907ed23c021d65af219302d624a65eae",
      "retrieved_at": "2026-11-18T20:45:37.949038+00:00",
      "currentness": "unresolved",
      "language": "en",
      "court": "Indiana trial courts"
    },
    "01912429b60859a199e51b5ad0913f": {
      "source_id": "US-IN:service:3dc98fb46370",
      "authority_type": "court_rule",
      "citation": "Ind. Trial Rule 4(B)",
      "text": "(B) Preparation of summons and praecipe. Contemporaneously with the filing of the complaint or equivalent pleading, the person seeking service or his attorney shall furnish to the clerk as many copies of the complaint and summons as are necessary. The clerk shall examine, date, sign, and affix his seal to the summons and thereupon issue and deliver the papers to the appropriate person for service. Affidavits, requests, and any other information relating to the summons and its service as required or permitted by these rules shall be included in a praecipe attached to or entered upon the summons. Such praecipe shall be deemed to be a part of the summons for purposes of these rules. Separate or additional summons shall, as provided by these rules, be issued by the clerk at any time upon proper request of the person seeking service or his attorney.",
      "text_sha256": "ade46cb36ea314300af0a242cb8702cba11ab6c809be37d4a5562f3406aaae2c",
      "publisher_sha256": "666be6fa8c14dd74f460558e8b398df7abc9d83e37ae5e995d523e1ee27f1b75",
      "retrieved_at": "2026-11-18T20:45:55.679956+00:00",
      "currentness": "unresolved",
      "language": "en",
      "court": "Indiana trial courts"
    },
    "3fc8653847bc2c6f7c25e5a5843f9c": {
      "source_id": "US-IN:response:ef3c46fed72e",
      "authority_type": "court_rule",
      "citation": "Ind. Trial Rule 12(A)",
      "text": "(A) When presented. The time allowed for the presentation of defenses and objections in a motion or responsive pleading is computed as set forth in this rule. Filing a motion permitted under this rule alters the time for filing a responsive pleading as follows, unless a different time is fixed by the court: (1) if the court does not grant the motion, the responsive pleading must be filed within ten days of the order; (2) if the court grants the motion and corrective action is permitted, an amended pleading taking the corrective action must be filed within ten days of the order, and the responsive pleading must be filed within ten days thereafter.",
      "text_sha256": "91a60d60bbf0ade84dd7ab203294079f052f8a807379913dab744fe7e9f70194",
      "publisher_sha256": "28d81afa2685b7f2f9d8a25e1d232b9b54b0a52e4b92cd9ff67f11acaa7f409b",
      "retrieved_at": "2026-11-18T20:45:55.864619+00:00",
      "currentness": "unresolved",
      "language": "en",
      "court": "Indiana trial courts"
    },
    "34f89a8f86d8e17f94b2ecb7dcca0b": {
      "source_id": "US-IN:fault:ec846fef5b5e",
      "authority_type": "opinion",
      "citation": "Ludwig v. Flaherty & Collins, Inc., No. 25A-CT-941, ¶ 11 (Ind. Ct. App. Mar. 16, 2026)",
      "text": "If the jury finds the plaintiff more than fifty percent at fault, it must “return a verdict for the defendant and no further deliberation of the jury is required.” I.C. § 34-51-2-7(b)(2).",
      "text_sha256": "3f049fe369139fa04668f8d7347fb947bd54c79a03c7a1a23287d745029c734d",
      "publisher_sha256": "6d6cb3d3deabc0a6391c68b1f022db1e5dddbb5e8e36c1d6e1fc73793d9e18b9",
      "retrieved_at": "2026-11-20T15:12:11.636524+00:00",
      "currentness": "historical",
      "language": "en",
      "edition": "Court opinion of 2026-03-16",
      "court": "Court of Appeals of Indiana",
      "decision_date": "2026-03-16",
      "opinion_role": "majority",
      "procedural_posture": "Appeal from a defense verdict in a premises negligence case."
    },
    "026729fda00ffc474530003038950b": {
      "source_id": "US-IN:pi_limitations:56bb950dd98d",
      "authority_type": "opinion",
