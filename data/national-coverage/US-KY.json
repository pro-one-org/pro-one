  "passages": {
    "5a7886e45780eff9eeb0444e858be6": {
      "citation": "KRS 413.140",
      "source_id": "US-KY:pi_limitations:ffd0fc99aa2e",
      "authority_type": "statute",
      "text": "413.140 Actions to be brought within one year. (1) The following actions shall be commenced within one (1) year after the cause of action accrued: (a) An action for an injury to the person of the plaintiff, or of her husband, his wife, child, ward, apprentice, or servant;",
      "text_sha256": "0e2b3861d9d1729790455e567e472a6c38c436d3af13020ec245009c1c6537e7",
      "publisher_sha256": "8c5a4cae5dbf648ec3e1194fcd63cf8d61b418174eeb1f08d330528ce87d12f6",
      "retrieved_at": "2026-11-17T19:33:57.481985+00:00",
      "language": "en",
      "currentness": "unresolved"
    },
    "b2a19060b397c9151b873af6c1c3d9": {
      "citation": "KRS 413.160",
      "source_id": "US-KY:written_contract_limitations:c1b4d8ff45da",
      "authority_type": "statute",
      "text": "413.160 Actions upon written contract or not provided for by statute -- Ten-year limitation. An action upon a written contract executed after July 15, 2014, unless otherwise provided by statute, and an action for relief not provided for by statute can only be commenced within ten (10) years after the cause of action accrued.",
      "text_sha256": "5a691ae6421d61aa16c4310089ea3f5e48164bd7a7f6442255506bb312949ace",
      "publisher_sha256": "65e6331dbeddeddda4c472260970beee2e8f7ce84da0f9b746307035894523c3",
      "retrieved_at": "2026-11-17T19:33:57.569065+00:00",
      "language": "en",
      "currentness": "unresolved"
    },
    "9ae41e9bd91ede686e1f39d36ae764": {
      "citation": "KRS 337.385",
      "source_id": "US-KY:wageLaw:df65e75e3813",
      "authority_type": "statute",
      "text": "(1) Except as provided in subsection (3) of this section, any employer who pays any employee less than wag es and overtime compensation to which such employee is entitled under or by virtue of KRS 337.020 to 337.285 shall be liable to such employee affected for the full amount of such wages and overtime compensation, less any amount actually paid to such employ ee by the employer, for an additional equal amount as liquidated damages, and for costs and such reasonable attorney's fees as may be allowed by the court.",
      "text_sha256": "9fd2b01d11ac6009f029c551f5294eccb4f7b108ce677d0660ee8c2a7cbc15f8",
      "publisher_sha256": "2ece3377951fcd848779a7f62958ec6d9f31a42fa627bf71318b999f14dff797",
      "retrieved_at": "2026-11-17T19:41:32.510695+00:00",
      "language": "en",
      "currentness": "unresolved"
    }
