  "passages": {
    "baeae5b5554e3faacc20868946a9b9": {
      "citation": "W. Va. Code § 55-2-12",
      "source_id": "US-WV:pi_limitations:945eb02348de",
      "authority_type": "statute",
      "text": "Every personal action for which no limitation is otherwise prescribed shall be brought: (a) Within two years next after the right to bring the same shall have accrued, if it be for damage to property; (b) within two years next after the right to bring the same shall have accrued if it be for damages for personal injuries; and (c) within one year next after the right to bring the same shall have accrued if it be for any other matter of such nature that, in case a party die, it could not have been brought at common law by or against his personal representative.",
      "text_sha256": "fc8c97743a06f262fba72850450addaeea56ef91210e12cb61a15aa62955721b",
      "publisher_sha256": "d35b06e1e0d12627fd88a684e4104988fdfd652073b526e8e1e95c8baf3cdf0b",
      "retrieved_at": "2026-11-17T19:34:03.185232+00:00",
      "language": "en",
      "currentness": "unresolved"
    },
    "6d76b6a53b6a5b86159c97896d5f82": {
      "source_id": "US-WV:commencement:3d10d489ede0",
      "citation": "W. Va. R. Civ. P. 3",
      "authority_type": "court_rule",
      "language": "en",
      "text": "Rule 3. Commencing an action. (a) A civil action is commenced by filing a complaint with the court. For a complaint naming more than one individual plaintiff not related by marriage, a derivative or fiduciary relationship, each plaintiff shall be assigned a separate civil action number and be docketed as a separate civil action and be charged a separate fee by the clerk of a circuit court. (b) Every complaint shall be accompanied by a completed civil case information statement, or the electronic equivalent, in the form prescribed by the Supreme Court of Appeals.",
      "text_sha256": "39495b3e71285bd240a1ede9c76cbe47adc409328a17fea19e8c06c751f2e44b",
      "publisher_sha256": "0ee05eb2712a88f1e98eba5414a7d1c8bb0612b4b95d77b5222a39fb9dfb64dd",
      "retrieved_at": "2026-11-17T20:14:22.334501+00:00",
      "currentness": "unresolved"
    },
    "5fa9c5ae27c2b416cddb492174fa23": {
      "citation": "W. Va. Code § 55-7-13c(c)",
      "source_id": "US-WV:fault:e61417b28dd7",
      "authority_type": "statute",
      "language": "en",
      "text": "(c) Any fault chargeable to the plaintiff shall not bar recovery by the plaintiff unless the plaintiff's fault is greater than the combined fault of all other persons responsible for the total amount of damages, if any, to be awarded. If the plaintiff's fault is less than the combined fault of all other persons, the plaintiff's recovery shall be reduced in proportion to the plaintiff's degree of fault.",
      "text_sha256": "fb00d2d0e739db49300b1f5cbeb569a6476f2f03009d5175df64fe89c20be6a1",
      "publisher_sha256": "0c5f40e58aab8c276572d96adacce22ed309e75c4d0c00302fe12e4cbb629c03",
      "retrieved_at": "2026-11-17T20:50:39.471656+00:00",
      "currentness": "unresolved"
    },
    "f47b8a50b8363786d0cb22d0fffb47": {
      "source_id": "US-WV:contract_formation:97df05fecf64",
      "authority_type": "statute",
      "citation": "W. Va. Code § 46-2-204",
      "text": "A contract for sale of goods may be made in any manner sufficient to show agreement, including conduct by both parties which recognizes the existence of such a contract.",
      "text_sha256": "9c77be9f087223530e0d86a71047d66373e3a4889718dffe0aff6b1ded1679b9",
      "publisher_sha256": "af8328e6be699d394ba63e6f2572f54ef7d58a7392c48d26cea9a4b89ef43c15",
      "retrieved_at": "2026-11-18T15:14:37.587210+00:00",
      "currentness": "unresolved",
      "language": "en"
    },
    "584c773fcf0566e171c14687ae5739": {
      "source_id": "US-WV:response:11a9ac6b5629",
      "authority_type": "court_rule",
      "citation": "W. Va. R. Civ. P. 12(a)(1)(A)",
      "text": "(1) In general. Unless another time is specified by this rule or a statute, the time for serving a responsive pleading is as follows: (A) A defendant shall serve an answer within 30 days after being served with the summons and complaint. Every answer shall be accompanied by a completed civil case information statement in the form prescribed by the Supreme Court of Appeals as required by Rule 3(b).",
      "text_sha256": "6a52f3eed6f983e8dff9579e1db249c748418a2f335c0a122454be85b5ee27fd",
      "publisher_sha256": "0ee05eb2712a88f1e98eba5414a7d1c8bb0612b4b95d77b5222a39fb9dfb64dd",
      "retrieved_at": "2026-11-17T20:14:22.334501+00:00",
      "currentness": "unresolved",
      "language": "en"
    },
    "7adaef092e1f0fc6489d56afb30851": {
      "source_id": "US-WV:service:968c26417455",
      "authority_type": "court_rule",
      "citation": "W. Va. R. Civ. P. 4(c)(1)",
      "text": "(c) Service. (1) In general . A summons shall be served with a copy of the complaint. The plaintiff is responsible for having the summons and complaint served within the time allowed by Rule 4(i) and shall furnish the necessary copies to the person who makes service.",
      "text_sha256": "0954ebeba3b97680ec3713b814b49ebdb390de8629588438eb2ba41230d3ca03",
      "publisher_sha256": "0ee05eb2712a88f1e98eba5414a7d1c8bb0612b4b95d77b5222a39fb9dfb64dd",
      "retrieved_at": "2026-11-17T20:14:22.334501+00:00",
      "currentness": "unresolved",
      "language": "en"
    }
  },
