  "passages": {
    "baeae5b5554e3faacc20868946a9b9": {
      "citation": "W. Va. Code § 55-2-12",
      "source_id": "US-WV:pi_limitations:945eb02348de",
      "authority_type": "statute",
      "text": "Every personal action for which no limitation is otherwise prescribed shall be brought: (a) Within two years next after the right to bring the same shall have accrued, if it be for damage to property; (b) within two years next after the right to bring the same shall have accrued if it be for damages for personal injuries; and (c) within one year next after the right to bring the same shall have accrued if it be for any other matter of such nature that, in case a party die, it could not have been brought at common law by or against his personal representative.",
      "text_sha256": "fc8c97743a06f262fba72850450addaeea56ef91210e12cb61a15aa62955721b",
      "publisher_sha256": "d35b06e1e0d12627fd88a684e4104988fdfd652073b526e8e1e95c8baf3cdf0b",
      "retrieved_at": "2026-11-17T19:34:03.185232+00:00",
      "language": "en",
      "currentness": "unresolved"
    },
    "6d76b6a53b6a5b86159c97896d5f82": {
      "source_id": "US-WV:commencement:3d10d489ede0",
      "citation": "W. Va. R. Civ. P. 3",
      "authority_type": "court_rule",
      "language": "en",
      "text": "Rule 3. Commencing an action. (a) A civil action is commenced by filing a complaint with the court. For a complaint naming more than one individual plaintiff not related by marriage, a derivative or fiduciary relationship, each plaintiff shall be assigned a separate civil action number and be docketed as a separate civil action and be charged a separate fee by the clerk of a circuit court. (b) Every complaint shall be accompanied by a completed civil case information statement, or the electronic equivalent, in the form prescribed by the Supreme Court of Appeals.",
      "text_sha256": "39495b3e71285bd240a1ede9c76cbe47adc409328a17fea19e8c06c751f2e44b",
      "publisher_sha256": "0ee05eb2712a88f1e98eba5414a7d1c8bb0612b4b95d77b5222a39fb9dfb64dd",
      "retrieved_at": "2026-11-17T20:14:22.334501+00:00",
      "currentness": "unresolved"
    }
  }
