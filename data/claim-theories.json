[
  {
    "id": "va_premises_warning",
    "version": "v1",
    "jurisdiction": "US-VA",
    "legal_area": "torts",
    "kind": "claim",
    "label": "Invitee premises liability and warning duty",
    "plain_language_label": "Store conditions and warnings for visitors",
    "capability": "va-premises-liability",
    "topics": [
      "premises_liability"
    ],
    "matter_types": [
      "personal_injury"
    ],
    "limitations": [
      "This catalog covers the invitee and warning passages only. It does not establish a complete negligence test or the meaning of constructive notice.",
      "The separate Austin analysis concerns an inference drawn on appeal from a ruling striking the evidence."
    ],
    "elements": [
      {
        "id": "invitee_care",
        "label": "Ordinary care toward invitees",
        "description": "The opinion describes a storeowner's duty to use ordinary care to make premises reasonably safe for an invitee's visit.",
        "kind": "requirement",
        "authority": [
          {
            "passage_id": "va-premises-duty",
            "source_id": "va-fultz-delhaize",
            "source_type": "court_opinion",
            "source_version": "Official opinion dated 2009-06-04",
            "excerpt_hash": "sha256:f0c35c6b9aa4a7a7b0f7f4e1bb5348379c888e825ccdbebb165bb9b4bdf397d1"
          }
        ],
        "fields": [
          {
            "field": "location",
            "question": "Where did the incident happen?",
            "scope": "event",
            "relation": "context"
          },
          {
            "field": "visit_purpose",
            "question": "What brought you to the premises that day?",
            "scope": "event",
            "relation": "context"
          },
          {
            "field": "operator",
            "question": "What record identifies the business operating this location?",
            "scope": "party",
            "relation": "context"
          },
          {
            "field": "hazard",
            "question": "What condition did you observe on the floor?",
            "scope": "event",
            "relation": "context"
          }
        ]
      },
      {
        "id": "warning",
        "label": "Warning about a condition known to the storeowner",
        "description": "The opinion describes a warning duty for an unsafe condition known to the storeowner and unknown to the invitee, subject to the stated visibility exception.",
        "kind": "condition",
        "authority": [
          {
            "passage_id": "va-premises-warning",
            "source_id": "va-fultz-delhaize",
            "source_type": "court_opinion",
            "source_version": "Official opinion dated 2009-06-04",
            "excerpt_hash": "sha256:164b052abe1841779ad94935fc9cde97f61c044fb6d20c0362226b330e1a4dd6"
          }
        ],
        "fields": [
          {
            "field": "employee_notice",
            "question": "Did anyone say what employees knew about the condition before the incident?",
            "scope": "event",
            "relation": "supporting"
          },
          {
            "field": "hazard_duration",
            "question": "What did you observe or hear about how long the condition was present?",
            "scope": "event",
            "relation": "context"
          },
          {
            "field": "warning_sign",
            "question": "What warnings, if any, did you see before the incident?",
            "scope": "event",
            "relation": "supporting",
            "adverse_value": true
          }
        ]
      },
      {
        "id": "open_and_obvious",
        "label": "Open and obvious condition",
        "description": "The opinion describes an exception where the condition would be obvious to a reasonable person using ordinary care.",
        "kind": "exception",
        "authority": [
          {
            "passage_id": "va-premises-warning",
            "source_id": "va-fultz-delhaize",
            "source_type": "court_opinion",
            "source_version": "Official opinion dated 2009-06-04",
            "excerpt_hash": "sha256:164b052abe1841779ad94935fc9cde97f61c044fb6d20c0362226b330e1a4dd6"
          }
        ],
        "fields": [
          {
            "field": "condition_visibility",
            "question": "What could you see about the condition as you approached?",
            "scope": "event",
            "relation": "context"
          }
        ],
        "parent": "warning"
      }
    ],
    "logic": {
      "op": "all",
      "operands": [
        {
          "op": "element",
          "element": "invitee_care"
        },
        {
          "op": "unless",
          "operands": [
            {
              "op": "element",
              "element": "warning"
            },
            {
              "op": "element",
              "element": "open_and_obvious"
            }
          ]
        }
      ]
    }
  },
